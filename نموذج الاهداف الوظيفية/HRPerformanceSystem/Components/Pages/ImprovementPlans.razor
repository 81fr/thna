@page "/improvement-plans"
@attribute [Authorize(Roles = "Admin, HR, Manager")]
@rendermode InteractiveServer
@using HRPerformanceSystem.Models
@using HRPerformanceSystem.Services
@inject AIInsightsService AISvc
@inject NotificationService NotifySvc
@inject IJSRuntime JS

<div class="page-header">
    <div>
        <div class="ai-badge" style="margin-bottom: 8px;display:inline-flex;align-items:center;gap:4px;"><Icon Name="target" Size="14" /> الذكاء الاصطناعي والتطوير</div>
        <h1 style="display:flex;align-items:center;gap:8px;"> خطط التحسين التلقائية (PIP)</h1>
        <div class="subtitle">خطط علاجية وتطويرية مخصصة تم توليدها بناءً على تحليل الأهداف والجدارات المنخفضة</div>
    </div>
    <div style="display: flex; gap: 12px; align-items:center;">
        <button class="btn btn-ai" @onclick="LoadPlans" disabled="@isLoading" style="display:inline-flex;align-items:center;gap:6px;">
            <Icon Name="refresh-cw" Size="16" /> تحديث الذكاء الاصطناعي
        </button>
    </div>
</div>

@if (isLoading)
{
    <div class="loading-container">
        <div class="loading-spinner"></div>
        <div class="loading-text" style="display:flex;align-items:center;gap:8px;justify-content:center;"><Icon Name="cpu" Size="20" /> جارٍ معالجة البيانات وتوليد خطط التحسين...</div>
    </div>
}
else if (!allPlans.Any())
{
    <div class="empty-state">
        <div class="icon"><Icon Name="check-circle" Size="48" Color="var(--success)" /></div>
        <h4>لا يوجد خطط تحسين مطلوبة</h4>
        <p>مستوى أداء جميع الموظفين في النطاق الآمن ولا توجد أهداف أو جدارات منخفضة.</p>
    </div>
}
else
{
    <!-- فلاتر البحث والترشيح -->
    <div class="card glass-search" style="padding: 20px; margin-bottom: 24px; background: rgba(255,255,255,0.6); backdrop-filter: blur(10px); border: 1px solid var(--border-light);">
        <div style="display: grid; grid-template-columns: 1.5fr 1fr 1fr 1fr; gap: 16px; align-items: center;">
            <div class="search-input-wrapper" style="position: relative;">
                <input class="form-control" placeholder="بحث باسم الموظف أو الرقم..." @bind="searchTerm" @bind:event="oninput" style="padding-right: 40px; border-radius: 12px;" />
                <div style="position:absolute; right:14px; top:14px; color:var(--text-muted);"><Icon Name="search" Size="16" /></div>
            </div>
            <select class="form-control" @bind="filterDept" style="border-radius: 12px;">
                <option value="">كل الإدارات</option>
                @foreach (var dept in departments) { <option value="@dept">@dept</option> }
            </select>
            <select class="form-control" @bind="filterPriority" style="border-radius: 12px;">
                <option value="">كل الأولويات</option>
                <option value="عالية جداً">أولوية قصوى</option>
                <option value="عالية">عالية</option>
                <option value="متوسطة">متوسطة</option>
            </select>
            <select class="form-control" @bind="filterType" style="border-radius: 12px;">
                <option value="">كل الأنواع</option>
                <option value="هدف وظيفي">أهداف وظيفية</option>
                <option value="جدارة">جدارات سلوكية</option>
            </select>
        </div>
    </div>

    <div class="stats-grid" style="margin-bottom: 30px;">
        <div class="premium-stat card">
            <div class="stat-icon" style="background: rgba(139, 92, 246, 0.1); color: #8b5cf6;"><Icon Name="users" Size="28" /></div>
            <div class="stat-info">
                <div class="label">إجمالي الخطط النشطة</div>
                <div class="value">@FilteredPlans.Count()</div>
            </div>
        </div>
        <div class="premium-stat card">
            <div class="stat-icon" style="background: rgba(239, 68, 68, 0.1); color: var(--danger);"><Icon Name="alert-triangle" Size="28" /></div>
            <div class="stat-info">
                <div class="label">حالات حرجة (أولوية قصوى)</div>
                <div class="value">@FilteredPlans.Count(p => p.Priority == "عالية جداً")</div>
            </div>
        </div>
    </div>

    <div style="display:grid; gap:30px;">
        @foreach (var plan in PagedPlans)
        {
            <div class="card premium-plan-card animate-in" style="border-right: 6px solid @(plan.Priority == "عالية جداً" ? "var(--danger)" : plan.Priority == "عالية" ? "var(--warning)" : "#0ea5e9");">
                <!-- Progress Stepper -->
                <div class="pip-stepper">
                    <div class="step active">
                        <div class="step-circle"><Icon Name="cpu" Size="14" /></div>
                        <div class="step-label">تم التوليد</div>
                    </div>
                    <div class="step-connector @(plan.IsSent ? "active" : "")"></div>
                    <div class="step @(plan.IsSent ? "active" : "")">
                        <div class="step-circle"><Icon Name="send" Size="14" /></div>
                        <div class="step-label">تم الإرسال</div>
                    </div>
                    <div class="step-connector @(plan.ProgressPercentage > 0 ? "active" : "")"></div>
                    <div class="step @(plan.ProgressPercentage > 0 ? "active" : "")">
                        <div class="step-circle"><Icon Name="trending-up" Size="14" /></div>
                        <div class="step-label">قيد التنفيذ (@plan.ProgressPercentage%)</div>
                    </div>
                </div>

                <!-- Header: Employee Info -->
                <div class="plan-card-header">
                    <div class="employee-meta">
                        <div class="user-avatar-large">@plan.EmployeeName.Substring(0, 1)</div>
                        <div class="info-group">
                            <h3 class="employee-name">
                                @plan.EmployeeName
                                <span class="priority-badge @(plan.Priority == "عالية جداً" ? "critical" : plan.Priority == "عالية" ? "high" : "medium")">
                                    أولوية @plan.Priority
                                </span>
                            </h3>
                            <div class="employee-details">
                                <span><Icon Name="briefcase" Size="14" /> @plan.JobTitle</span>
                                <span class="separator">|</span>
                                <span><Icon Name="hash" Size="14" /> @plan.EmployeeNumber</span>
                                <span class="separator">|</span>
                                <span><Icon Name="map-pin" Size="14" /> @plan.Department</span>
                            </div>
                        </div>
                    </div>
                    <div class="timeframe-box">
                        <div class="label">الفترة الزمنية للإصلاح</div>
                        <div class="value"><Icon Name="clock" Size="16" /> @plan.Timeframe</div>
                    </div>
                </div>

                <!-- Source Analysis -->
                <div class="source-analysis-section">
                    <div class="section-title">
                        <Icon Name="@(plan.ItemType == "هدف وظيفي" ? "target" : "award")" Size="18" />
                        تحليل الفجوة: @plan.ItemType
                    </div>
                    <div class="source-content">
                        <div class="quote-text">"@plan.SourceItem"</div>
                        <div class="score-tracking">
                            <div class="score-item current">
                                <span class="label">النتيجة الحالية</span>
                                <div class="progress-mini">
                                    <div class="progress-bar-mini bg-danger" style="width: @plan.CurrentScore%"></div>
                                </div>
                                <span class="value">@plan.CurrentScore%</span>
                            </div>
                            <div class="score-divider">
                                <Icon Name="chevrons-left" Size="20" />
                            </div>
                            <div class="score-item target">
                                <span class="label">المستهدف المطلوب</span>
                                <div class="progress-mini">
                                    <div class="progress-bar-mini bg-success" style="width: @plan.TargetScore%"></div>
                                </div>
                                <span class="value">@plan.TargetScore%</span>
                            </div>
                        </div>
                    </div>
                </div>

                <!-- Executive Tasks Table -->
                <div class="executive-tasks-section">
                    <div class="section-title">
                        <Icon Name="list" Size="18" />
                        خطة المهام التنفيذية (Executive Execution Plan)
                    </div>
                    <div class="table-responsive">
                        <table class="tasks-table">
                            <thead>
                                <tr>
                                    <th>المهمة التنفيذية</th>
                                    <th>المسؤول</th>
                                    <th>الموعد النهائي</th>
                                    <th>الحالة</th>
                                </tr>
                            </thead>
                            <tbody>
                                @foreach (var task in plan.ExecutiveTasks)
                                {
                                    <tr>
                                        <td>
                                            <div style="font-weight: 700; color: var(--text-primary);">@task.Title</div>
                                            <div style="font-size: 0.75rem; color: var(--text-muted);">@task.Description</div>
                                        </td>
                                        <td><span class="badge-outline">@task.Responsible</span></td>
                                        <td><span style="font-size: 0.8rem; font-weight: 600;">@task.Deadline</span></td>
                                        <td><span class="status-dot">@task.Status</span></td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                </div>
                
                <!-- Action Buttons -->
                <div class="plan-card-footer">
                    <div class="ai-verification">
                        <div class="engine-tag"><Icon Name="cpu" Size="12" /> AI Engine v4.2</div>
                        <span>تم تحليل الأداء وتوليد المسار العلاجي تلقائياً</span>
                    </div>
                    <div class="actions-group">
                        <button class="btn btn-outline-primary btn-sm" onclick="window.print()" type="button" style="padding: 6px 12px;">
                            <Icon Name="printer" Size="14" /> 
                            <span>طباعة</span>
                        </button>
                        <button class="btn btn-primary btn-sm btn-premium @(plan.IsSent ? "btn-sent" : "")" @onclick="() => SendToEmployee(plan)" disabled="@isSending" type="button">
                            @if (isSending)
                            {
                                <span class="spinner-border spinner-border-sm" role="status" aria-hidden="true"></span>
                            }
                            else if (plan.IsSent)
                            {
                                <Icon Name="check" Size="14" />
                                <span>تم الإرسال مسبقاً</span>
                            }
                            else
                            {
                                <Icon Name="send" Size="14" />
                                <span>اعتماد وإرسال</span>
                            }
                        </button>
                    </div>
                </div>
            </div>
        }
    </div>

    <!-- التحكم في الصفحات -->
    @if (TotalPages > 1)
    {
        <div class="pagination-container">
            <button class="btn btn-outline btn-sm" disabled="@(currentPage == 1)" @onclick="() => currentPage--">السابق</button>
            <div class="page-indicator">
                صفحة <span>@currentPage</span> من @TotalPages
            </div>
            <button class="btn btn-outline btn-sm" disabled="@(currentPage == TotalPages)" @onclick="() => currentPage++">التالي</button>
        </div>
    }
}

