@code {
    List<ImprovementPlan> allPlans = new();
    List<string> departments = new();
    bool isLoading = true;
    bool isSending = false;

    // Filters
    string searchTerm = "";
    string filterDept = "";
    string filterPriority = "";
    string filterType = "";

    // Pagination
    int currentPage = 1;
    int pageSize = 5;

    IEnumerable<ImprovementPlan> FilteredPlans => allPlans.Where(p =>
        (string.IsNullOrEmpty(searchTerm) || p.EmployeeName.Contains(searchTerm) || p.EmployeeNumber.Contains(searchTerm)) &&
        (string.IsNullOrEmpty(filterDept) || p.Department == filterDept) &&
        (string.IsNullOrEmpty(filterPriority) || p.Priority == filterPriority) &&
        (string.IsNullOrEmpty(filterType) || p.ItemType == filterType)
    );

    IEnumerable<ImprovementPlan> PagedPlans => FilteredPlans
        .Skip((currentPage - 1) * pageSize)
        .Take(pageSize);

    int TotalPages => (int)Math.Ceiling(FilteredPlans.Count() / (double)pageSize);

    protected override async Task OnInitializedAsync()
    {
        await LoadPlans();
    }

    async Task LoadPlans()
    {
        isLoading = true;
        currentPage = 1;
        StateHasChanged();
        
        await Task.Delay(800); // Simulate AI processing
        allPlans = await AISvc.GenerateImprovementPlansAsync();
        
        // Mock some progress for visual demo
        if (allPlans.Count > 0) {
            allPlans[0].IsSent = true;
            if (allPlans[0].ExecutiveTasks.Count > 0) {
                allPlans[0].ExecutiveTasks[0].Status = "مكتمل";
            }
        }
        if (allPlans.Count > 1) {
            allPlans[1].IsSent = true;
            foreach(var t in allPlans[1].ExecutiveTasks.Take(2)) t.Status = "قيد التنفيذ";
        }

        departments = allPlans
            .Select(p => p.Department)
            .Where(d => !string.IsNullOrEmpty(d))
            .Distinct()
            .OrderBy(d => d)
            .ToList();
            
        isLoading = false;
        StateHasChanged();
    }

    async Task PrintPlan()
    {
        await JS.InvokeVoidAsync("window.print");
    }

    async Task SendToEmployee(ImprovementPlan plan)
    {
        Console.WriteLine($"[PIP] Sending plan for {plan.EmployeeName} (ID: {plan.EmployeeId})");
        isSending = true;
        StateHasChanged();
        
        try 
        {
            await Task.Delay(1000); // Simulate network
            
            await NotifySvc.CreateAsync(
                "خطة تحسين أداء جديدة",
                $"تم اعتماد خطة تحسين أداء لك بناءً على تحليل نتائجك في {plan.SourceItem}. يرجى مراجعة المهام التنفيذية.",
                NotificationType.Warning,
                $"/profile",
                plan.UserId
            );

            plan.IsSent = true;
            Console.WriteLine($"[PIP] Notification created for {plan.UserId}");
            await JS.InvokeVoidAsync("alert", $"✅ تم اعتماد الخطة بنجاح!\n\nتم إرسال التنبيه للموظف: {plan.EmployeeName}\nمعرف الموظف: {plan.EmployeeNumber}");
        }
        catch (Exception ex)
        {
            Console.WriteLine($"[PIP] Error sending plan: {ex.Message}");
            await JS.InvokeVoidAsync("alert", "❌ حدث خطأ أثناء إرسال الخطة. يرجى المحاولة مرة أخرى.");
        }
        finally
        {
            isSending = false;
            StateHasChanged();
        }
    }
}
