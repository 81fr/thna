          <div class="kpi-value" style="color:var(--good)">83.6%</div>
          <span class="kpi-badge badge-good">جيد</span>
          <div class="kpi-sub">14 إدارة | 86.8% مبادرات</div>
          <div class="analysis-panel" id="sum-ops">
            <button class="close-btn" onclick="event.stopPropagation();toggleAnalysis('sum-ops')">✕</button>
            <div class="analysis-item"><span class="label">أداء المبادرات:</span><span class="value">86.8% (جيد)</span></div>
