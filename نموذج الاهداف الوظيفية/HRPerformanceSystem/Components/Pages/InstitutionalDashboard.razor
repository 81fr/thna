    if(q.includes('موارد') || q.includes('بشرية')) reply = "نسبة الالتزام بالقيم في الموارد البشرية هي " + (data.hr?.compliance || "100") + "%.";
    
    bMsg.innerText = reply;
    body.appendChild(bMsg);
    body.scrollTop = body.scrollHeight;
  }, 700);
}//
