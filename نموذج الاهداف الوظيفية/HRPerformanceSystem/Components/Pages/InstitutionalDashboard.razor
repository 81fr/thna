};

// Datalabels config for bar charts (value shown on/inside bar)
function barDL(suffix, opts={}) {
  return {
    datalabels: {
      anchor: opts.anchor || 'end',
      align: opts.align || 'end',
      color: opts.color || '#000000',
      font: { family:'IBM Plex Sans Arabic, sans-serif', size: opts.size||13, weight:'800' },
      formatter: (v) => v > 0 ? (v + (suffix||'')) : '',
      clip: false,
      padding: { right: 4 }
    }
  };
}

// Datalabels config for bar charts where label is inside the bar
function barDLInside(suffix) {
  return {
    datalabels: {
      anchor:'center', align:'center',
      color:'#fff',
      font:{ family:'IBM Plex Sans Arabic, sans-serif', size:11, weight:'700' },
      formatter:(v) => v > 0 ? (v+(suffix||'')) : ''
    }
  };
}

// Datalabels for doughnut/pie
function pieDL(labels, data) {
  return {
    datalabels: {
      color:'#fff',
      font:{ family:'IBM Plex Sans Arabic, sans-serif', size:12, weight:'700' },
      formatter:(v, ctx) => {
        const pct = Math.round(v / data.reduce((a,b)=>a+b,0) * 100);
        return pct > 4 ? v + '\n(' + pct + '%)' : '';
      },
      textAlign:'center'
    }
  };
}

// Datalabels for line charts (above each point)
const lineDL = {
  datalabels: {
    anchor:'end', align:'top', offset:4,
    color: ctx => {
      const v = ctx.dataset.data[ctx.dataIndex];
      return v >= 90 ? '#16a34a' : v >= 70 ? '#d97706' : '#dc2626';
    },
    font:{ family:'IBM Plex Sans Arabic, sans-serif', size:10, weight:'700' },
    formatter: v => v + '%'
  }
};

