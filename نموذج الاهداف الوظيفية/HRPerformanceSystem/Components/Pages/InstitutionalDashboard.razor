@page "/institutional-dashboard"
@rendermode InteractiveServer
@attribute [Microsoft.AspNetCore.Authorization.Authorize]
@using HRPerformanceSystem.Data
@using HRPerformanceSystem.Models
@using Microsoft.EntityFrameworkCore
@inject IDbContextFactory<ApplicationDbContext> DbFactory
@inject IJSRuntime JS
@inject ToastService ToastSvc
@inject AIInsightsService AISvc
@layout HRPerformanceSystem.Components.Layout.EmptyLayout
<!DOCTYPE html>
<html lang="ar" dir="rtl">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>لوحة القيادة المؤسسية - جمعية تراؤف لرعاية الأيتام</title>
<script src="https://cdnjs.cloudflare.com/ajax/libs/Chart.js/4.4.1/chart.umd.min.js"></script>
<script src="https://cdnjs.cloudflare.com/ajax/libs/chartjs-plugin-datalabels/2.2.0/chartjs-plugin-datalabels.min.js"></script>
<style>
  @@import url('https://fonts.googleapis.com/css2?family=IBM+Plex+Sans+Arabic:wght@300;400;500;600;700&display=swap');
  
  :root {
    --primary: #00897B;
    --primary-dark: #00695C;
    --primary-light: #4DB6AC;
    --accent: #7BC143;
    --accent-light: #98D06E;
    --bg: #F8FAFC;
    --sidebar-bg: #ffffff;
    --card-bg: rgba(255, 255, 255, 0.95);
    --text: #1a202c;
    --text-muted: #4a5568;
    --border: rgba(0, 0, 0, 0.1);
    --shadow: 0 4px 6px -1px rgba(0, 0, 0, 0.05);
    --shadow-lg: 0 20px 25px -5px rgba(0, 0, 0, 0.1);
    --radius: 24px;
    --radius-sm: 12px;
    --glass: rgba(255, 255, 255, 0.75);
    --blur: blur(12px);
    
    --excellent: #10B981;
    --excellent-bg: rgba(16, 185, 129, 0.1);
    --good: #F59E0B;
    --good-bg: rgba(245, 158, 11, 0.1);
    --weak: #EF4444;
    --weak-bg: rgba(239, 68, 68, 0.1);
    --pending: #94A3B8;
    --pending-bg: rgba(148, 163, 184, 0.1);
  }

  [data-theme=dark] {
    --bg: #0F172A;
    --sidebar-bg: #1E293B;
    --card-bg: rgba(30, 41, 59, 0.75);
    --text: #F1F5F9;
    --text-muted: #94A3B8;
    --border: rgba(51, 65, 85, 0.8);
    --glass: rgba(30, 41, 59, 0.8);
  }

  * { margin:0; padding:0; box-sizing:border-box; }
  body {
    font-family: 'IBM Plex Sans Arabic', sans-serif;
    background: var(--bg);
    color: var(--text);
    direction: rtl;
    min-height: 100vh;
    font-size: 11px;
    font-weight: 600;
  }
  .header-prepared { font-size: 11px; opacity: 0.7; text-align: left; }

  /* ===== TABS ===== */
  .tabs-bar {
    background: var(--primary);
    overflow-x: auto;
    scrollbar-width: none;
    border-bottom: 3px solid var(--accent);
    position: sticky;
    top: 64px;
    z-index: 90;
  }
  .tabs-bar::-webkit-scrollbar { display: none; }
  .tabs-list {
    display: flex;
    min-width: max-content;
    padding: 0 16px;
  }
  .tab-btn {
    padding: 12px 16px;
    background: none;
    border: none;
    color: rgba(255,255,255,0.65);
    font-family: inherit;
    font-size: 13px;
    cursor: pointer;
    white-space: nowrap;
    transition: all 0.2s;
    border-bottom: 3px solid transparent;
    margin-bottom: -3px;
    position: relative;
  }
  .tab-btn:hover { color: white; background: rgba(255,255,255,0.08); }
  .tab-btn.active {
    color: var(--accent-light);
    border-bottom-color: var(--accent-light);
    font-weight: 600;
    background: rgba(255,255,255,0.05);
  }

  /* ===== PAGES ===== */
  .page { display: none; padding: 0; max-width: 1600px; margin: 0 auto; animation: fadeUp 0.6s cubic-bezier(0.4, 0, 0.2, 1); }
  .page.active { display: block; }
  @@keyframes fadeUp { from { opacity: 0; transform: translateY(20px); } to { opacity: 1; transform: translateY(0); } }

  /* ===== FOOTER ===== */
  .footer {
    background: var(--primary);
    color: rgba(255,255,255,0.6);
    text-align: center;
    padding: 14px 24px;
    font-size: 12px;
    margin-top: 40px;
    display: flex;
    align-items: center;
    justify-content: space-between;
  }

  /* ===== SECTION TITLES ===== */
  .section-title {
    font-size: 18px;
    font-weight: 700;
    color: var(--primary);
    margin-bottom: 16px;
    padding-bottom: 10px;
    border-bottom: 2px solid var(--accent);
    display: flex; align-items: center; gap: 10px;
  }
  .section-title .icon { font-size: 20px; }
  .sub-title {
    font-size: 15px;
    font-weight: 600;
    color: var(--primary-light);
    margin: 20px 0 12px;
    padding-right: 10px;
    border-right: 3px solid var(--accent);
  }

  /* ===== GRID ===== */
  .grid-2 { display: grid; grid-template-columns: repeat(2, 1fr); gap: 16px; }
  .grid-3 { display: grid; grid-template-columns: repeat(3, 1fr); gap: 16px; }
  .grid-4 { display: grid; grid-template-columns: repeat(4, 1fr); gap: 16px; }
  .grid-5 { display: grid; grid-template-columns: repeat(5, 1fr); gap: 12px; }
  .grid-7 { display: grid; grid-template-columns: repeat(7, 1fr); gap: 10px; }

  @@media (max-width: 900px) {
    .grid-4, .grid-5, .grid-7 { grid-template-columns: repeat(2, 1fr); }
    .grid-3 { grid-template-columns: repeat(2, 1fr); }
  }

  /* ===== KPI CARDS ===== */
  .kpi-card {
    background: var(--card-bg);
    border-radius: var(--radius);
    padding: 18px 16px;
    box-shadow: var(--shadow);
    cursor: pointer;
    transition: all 0.25s;
    border: 2px solid transparent;
    position: relative;
    overflow: hidden;
  }
  .kpi-card:hover { transform: translateY(-2px); box-shadow: var(--shadow-lg); }
  .kpi-card:hover { border-color: var(--accent); }
  .kpi-card.excellent { border-right: 4px solid var(--excellent); }
  .kpi-card.good { border-right: 4px solid var(--good); }
  .kpi-card.weak { border-right: 4px solid var(--weak); }
  .kpi-card.pending { border-right: 4px solid var(--pending); }
  
  .kpi-label { font-size: 13px; color: var(--text-muted); margin-bottom: 8px; font-weight: 700; }
  .kpi-value { font-size: 32px; font-weight: 800; line-height: 1; color: var(--text); text-shadow: 0 1px 2px rgba(0,0,0,0.05); }
  .kpi-sub { font-size: 11px; color: var(--text-muted); margin-top: 6px; }
  .kpi-badge {
    display: inline-block; padding: 3px 10px; border-radius: 20px;
    font-size: 11px; font-weight: 600; margin-top: 8px;
  }
  .badge-excellent { background: var(--excellent-bg); color: var(--excellent); }
  .badge-good { background: var(--good-bg); color: var(--good); }
  .badge-weak { background: var(--weak-bg); color: var(--weak); }
  .badge-pending { background: var(--pending-bg); color: var(--pending); }

  /* ===== BIG KPI ===== */
  .big-kpi {
    background: linear-gradient(135deg, var(--primary) 0%, var(--primary-light) 100%);
    color: white;
    border-radius: var(--radius);
    padding: 28px 24px;
    text-align: center;
    box-shadow: var(--shadow-lg);
  }
  .big-kpi-value { font-size: 52px; font-weight: 700; line-height: 1; }
  .big-kpi-label { font-size: 14px; opacity: 0.85; margin-top: 8px; }
  .big-kpi-sub { font-size: 12px; opacity: 0.65; margin-top: 6px; }

  /* ===== ANALYSIS PANEL ===== */
  .analysis-panel {
    display: none;
    background: #f8fafc;
    border: 1.5px solid var(--border);
    border-radius: var(--radius-sm);
    padding: 16px;
    margin-top: 12px;
    position: relative;
    animation: slideDown 0.2s ease;
  }
  .analysis-panel.open { display: block; }
  @@keyframes slideDown { from { opacity:0; transform:translateY(-8px); } to { opacity:1; transform:translateY(0); } }
  .analysis-panel .close-btn {
    position: absolute; top: 10px; left: 10px;
    background: var(--weak); color: white; border: none;
    width: 24px; height: 24px; border-radius: 50%; cursor: pointer; font-size: 12px;
    display: flex; align-items: center; justify-content: center;
    transition: background 0.2s;
  }
  .analysis-panel .close-btn:hover { background: #b91c1c; }
  .analysis-item { display: flex; gap: 10px; margin-bottom: 8px; font-size: 13px; }
  .analysis-item .label { color: var(--text-muted); min-width: 120px; font-weight: 500; }
  .analysis-item .value { color: var(--text); flex: 1; }

  /* ===== CHART CONTAINER ===== */
  .chart-box {
    background: var(--card-bg);
    border-radius: var(--radius);
    padding: 20px;
    box-shadow: var(--shadow);
  }
  .chart-title { font-size: 14px; font-weight: 600; margin-bottom: 16px; color: var(--primary); }
  .chart-wrap { position: relative; height: 260px; }
  .chart-wrap-sm { position: relative; height: 200px; }
  .chart-wrap-lg { position: relative; height: 320px; }

  /* ===== TABLE ===== */
  .data-table {
    width: 100%; border-collapse: collapse;
    background: var(--card-bg);
    border-radius: var(--radius);
    overflow: hidden;
    box-shadow: var(--shadow);
    font-size: 13px;
  }
  .data-table th {
    background: var(--primary);
    color: white;
    padding: 12px 14px;
    text-align: right;
    font-weight: 600;
    font-size: 12px;
  }
  .data-table td {
    padding: 11px 14px;
    border-bottom: 1px solid var(--border);
    vertical-align: middle;
  }
  .data-table tr:last-child td { border-bottom: none; }
  .data-table tr:hover td { background: #f8fafd; }
  .data-table tr.clickable { cursor: pointer; }

  /* ===== STATUS DOTS ===== */
  .dot { display: inline-block; width: 10px; height: 10px; border-radius: 50%; margin-left: 6px; }
  .dot-excellent { background: var(--excellent); }
  .dot-good { background: var(--good); }
  .dot-weak { background: var(--weak); }
  .dot-pending { background: var(--pending); }

  /* ===== PROGRESS BAR ===== */
  .progress-bar-wrap { background: #e5eaf0; border-radius: 6px; height: 10px; overflow: hidden; }
  .progress-bar-fill { height: 100%; border-radius: 6px; transition: width 1s ease; }
  .fill-excellent { background: var(--excellent); }
  .fill-good { background: var(--good); }
  .fill-weak { background: var(--weak); }

  /* Mesh Background */
  .mesh-bg {
    position: fixed; top: 0; left: 0; width: 100%; height: 100%;
    z-index: -1; opacity: 0.6; pointer-events: none;
    background: 
      radial-gradient(at 0% 0%, rgba(0, 137, 123, 0.15) 0px, transparent 50%),
      radial-gradient(at 100% 0%, rgba(123, 193, 67, 0.15) 0px, transparent 50%),
      radial-gradient(at 50% 50%, rgba(0, 137, 123, 0.05) 0px, transparent 50%),
      radial-gradient(at 0% 100%, rgba(123, 193, 67, 0.1) 0px, transparent 50%);
  }

  /* LAYOUT */
  .app-container { display: flex; min-height: 100vh; }
  
  .sidebar {
    width: 280px; background: var(--sidebar-bg); border-left: 1px solid var(--border);
    height: 100vh; position: fixed; right: 0; top: 0; display: flex; flex-direction: column;
    z-index: 1000; transition: transform 0.3s ease; box-shadow: var(--shadow);
  }
  .sidebar-header { padding: 32px 24px; }
  .logo-area { display: flex; align-items: center; gap: 12px; }
  .logo-icon {
    width: 44px; height: 44px; border-radius: 12px;
    background: linear-gradient(135deg, var(--primary), var(--accent));
    display: flex; align-items: center; justify-content: center;
    color: white; font-weight: 700; font-size: 20px; box-shadow: 0 8px 16px rgba(0,137,123,0.3);
  }
  .logo-text { font-weight: 800; font-size: 22px; color: var(--primary); letter-spacing: -1px; }

  .nav-list { flex: 1; padding: 12px 16px; overflow-y: auto; }
  .nav-item {
    display: flex; align-items: center; gap: 14px; padding: 10px 14px;
    border-radius: 14px; color: var(--text-muted); cursor: pointer;
    transition: all 0.3s cubic-bezier(0.4, 0, 0.2, 1); margin-bottom: 6px;
    font-weight: 600; font-size: 13.5px;
  }
  .nav-item:hover { background: rgba(0, 137, 123, 0.08); color: var(--primary); transform: translateX(-6px); }
  .nav-item.active { 
    background: linear-gradient(135deg, var(--primary), var(--primary-dark)); 
    color: white; 
    box-shadow: 0 12px 24px -8px rgba(0,137,123,0.5); 
  }

  /* ICON CONTAINERS */
  .icon-box {
    width: 34px; height: 34px; border-radius: 10px;
    display: flex; align-items: center; justify-content: center;
    background: rgba(0,0,0,0.03); color: var(--text-muted);
    transition: all 0.3s;
  }
  .nav-item:hover .icon-box { background: rgba(255,255,255,0.2); color: inherit; }
  .nav-item.active .icon-box { background: rgba(255,255,255,0.2); color: white; }

  /* CATEGORY COLORS */
  .c-dashboard { color: #0ea5e9; background: rgba(14, 165, 233, 0.1); }
  .c-strategy { color: #ef4444; background: rgba(239, 68, 68, 0.1); }
  .c-ops { color: #8b5cf6; background: rgba(139, 92, 246, 0.1); }
  .c-hr { color: #f59e0b; background: rgba(245, 158, 11, 0.1); }
  .c-finance { color: #10b981; background: rgba(16, 185, 129, 0.1); }
  .c-risk { color: #ef4444; background: rgba(239, 68, 68, 0.1); }
  .c-gov { color: #6366f1; background: rgba(99, 102, 241, 0.1); }
  .c-ai { color: #d946ef; background: rgba(217, 70, 239, 0.1); }

  .main-wrapper { flex: 1; margin-right: 280px; display: flex; flex-direction: column; min-height: 100vh; }
  .top-header {
    height: 90px; padding: 0 40px; display: flex; align-items: center; justify-content: space-between;
    position: sticky; top: 0; z-index: 900; background: rgba(248, 250, 252, 0.8);
    backdrop-filter: blur(12px); border-bottom: 1px solid var(--border);
  }
  [data-theme=dark] .top-header { background: rgba(15, 23, 42, 0.8); }

  .search-bar {
    display: flex; align-items: center; background: rgba(0,0,0,0.03);
    padding: 10px 20px; border-radius: 16px; width: 400px; gap: 12px;
    border: 1px solid transparent; transition: all 0.3s;
  }
  .search-bar:focus-within { background: white; border-color: var(--primary); box-shadow: 0 0 0 4px rgba(0,137,123,0.1); }
  .search-input { border: none; background: transparent; outline: none; width: 100%; font-family: inherit; font-size: 13px; }

  .header-actions { display: flex; align-items: center; gap: 24px; }
  .icon-btn {
    width: 44px; height: 44px; border-radius: 14px; border: 1px solid var(--border);
    display: flex; align-items: center; justify-content: center; cursor: pointer;
    position: relative; transition: all 0.2s; background: white;
  }
  .icon-btn:hover { background: var(--bg); transform: translateY(-2px); }
  .badge-dot { position: absolute; top: 10px; right: 10px; width: 10px; height: 10px; background: var(--weak); border: 2px solid white; border-radius: 50%; }

  .user-profile { display: flex; align-items: center; gap: 12px; padding-right: 24px; border-right: 1px solid var(--border); }
  .user-avatar { width: 44px; height: 44px; border-radius: 14px; background: var(--accent); color: white; display: flex; align-items: center; justify-content: center; font-weight: 800; font-size: 18px; }
  .user-info { display: flex; flex-direction: column; }
  .user-name { font-size: 14px; font-weight: 700; color: var(--text); }
  .user-role { font-size: 11px; color: var(--text-muted); }

  .content-area { padding: 40px; flex: 1; max-width: 1600px; margin: 0 auto; width: 100%; }

  /* CARDS & GRIDS */
  .grid { display: grid; gap: 24px; margin-bottom: 32px; }
  .grid-4 { grid-template-columns: repeat(4, 1fr); }
  .grid-3 { grid-template-columns: repeat(3, 1fr); }
  .grid-2 { grid-template-columns: repeat(2, 1fr); }

  .glass-card {
    background: var(--card-bg); backdrop-filter: var(--blur);
    border: 1px solid var(--border); border-radius: var(--radius);
    padding: 24px; box-shadow: var(--shadow); transition: all 0.3s ease;
    height: 100%;
  }
  .glass-card:hover { transform: translateY(-6px); box-shadow: var(--shadow-lg); }

  .stat-label { font-size: 13px; color: var(--text-muted); font-weight: 700; text-transform: uppercase; letter-spacing: 0.5px; }
  .stat-value { font-size: 36px; font-weight: 800; color: var(--primary); margin: 8px 0; text-shadow: 0 1px 2px rgba(0,0,0,0.05); }
  .stat-trend { font-size: 12px; font-weight: 700; display: flex; align-items: center; gap: 4px; }
  .trend-up { color: #10B981; }

  .chart-title { font-size: 16px; font-weight: 700; color: var(--text); margin-bottom: 24px; display: flex; align-items: center; gap: 10px; }
  .chart-title::before { content:''; width:4px; height:20px; background:var(--accent); border-radius:10px; }

  /* ===== COVER PAGE ===== */
  .cover-page {
    min-height: calc(100vh - 130px);
    display: flex; flex-direction: column;
    align-items: center; justify-content: center;
    background: linear-gradient(160deg, var(--primary) 0%, var(--primary-light) 60%, #1e4a7a 100%);
    border-radius: var(--radius);
    color: white;
    text-align: center;
    padding: 60px 40px;
    position: relative;
    overflow: hidden;
  }
  .cover-page::before {
    content: '';
    position: absolute;
    top: -40%; right: -20%;
    width: 500px; height: 500px;
    background: radial-gradient(circle, rgba(200,146,42,0.18) 0%, transparent 70%);
    border-radius: 50%;
  }
  .cover-logo {
    width: 100px; height: 100px;
    background: var(--accent);
    border-radius: 50%;
    display: flex; align-items: center; justify-content: center;
    font-size: 48px; font-weight: 700;
    margin: 0 auto 28px;
    box-shadow: 0 8px 32px rgba(200,146,42,0.4);
  }
  .cover-title { font-size: 32px; font-weight: 700; margin-bottom: 12px; }
  .cover-org { font-size: 20px; opacity: 0.9; margin-bottom: 20px; }
  .cover-period {
    background: var(--accent);
    color: white;
    padding: 8px 24px;
    border-radius: 30px;
    font-size: 16px;
    font-weight: 600;
    margin-bottom: 20px;
    display: inline-block;
  }
  .cover-desc { font-size: 14px; opacity: 0.75; max-width: 600px; line-height: 1.7; margin-bottom: 32px; }
  .cover-meta { display: flex; gap: 40px; justify-content: center; flex-wrap: wrap; }
  .cover-meta-item { font-size: 13px; opacity: 0.8; }
  .cover-meta-item strong { display: block; font-size: 15px; opacity: 1; }
  .cover-version {
    position: absolute;
    top: 20px; left: 20px;
    background: rgba(255,255,255,0.15);
    padding: 4px 12px;
    border-radius: 20px;
    font-size: 11px;
  }

  /* ===== ALERT BOXES ===== */
  .alert { border-radius: var(--radius-sm); padding: 12px 16px; margin-bottom: 8px; font-size: 13px; }
  .alert-info { background: #eff6ff; border-right: 3px solid #3b82f6; color: #1e40af; }
  .alert-warn { background: #fffbeb; border-right: 3px solid var(--good); color: #92400e; }
  .alert-danger { background: var(--weak-bg); border-right: 3px solid var(--weak); color: #991b1b; }
  .alert-success { background: var(--excellent-bg); border-right: 3px solid var(--excellent); color: #14532d; }

  /* ===== COLOR KEY ===== */
  .color-key {
    display: flex; flex-wrap: wrap; gap: 12px;
    background: var(--card-bg); border-radius: var(--radius-sm);
    padding: 12px 16px; margin-bottom: 20px;
    box-shadow: var(--shadow);
  }
  .color-key-item { display: flex; align-items: center; gap: 6px; font-size: 12px; }
  .color-key-dot { width: 14px; height: 14px; border-radius: 4px; }

  /* ===== RISK MAP ===== */
  .risk-map {
    display: grid;
    grid-template-columns: 40px repeat(5, 1fr);
    grid-template-rows: repeat(5, 1fr) 40px;
    gap: 3px;
    height: 280px;
    margin-bottom: 12px;
  }
  .risk-cell {
    border-radius: 4px;
    display: flex; align-items: center; justify-content: center;
    font-size: 12px; font-weight: 600;
    cursor: pointer; transition: opacity 0.2s;
  }
  .risk-cell:hover { opacity: 0.85; }
  .risk-axis { display: flex; align-items: center; justify-content: center; font-size: 10px; color: var(--text-muted); font-weight: 600; }
  .risk-axis-v { writing-mode: vertical-rl; text-orientation: mixed; transform: rotate(180deg); }

  /* ===== DIMENSION CARD ===== */
  .dim-card {
    background: var(--card-bg); border-radius: var(--radius);
    padding: 20px; box-shadow: var(--shadow);
    cursor: pointer; transition: all 0.25s;
    border-top: 4px solid var(--border);
  }
  .dim-card:hover { transform: translateY(-3px); box-shadow: var(--shadow-lg); }
  .dim-card.excellent { border-top-color: var(--excellent); }
  .dim-card.good { border-top-color: var(--good); }
  .dim-card.weak { border-top-color: var(--weak); }
  .dim-title { font-size: 14px; font-weight: 700; margin-bottom: 8px; }
  .dim-value { font-size: 32px; font-weight: 700; }
  .dim-goals { font-size: 12px; color: var(--text-muted); margin-top: 8px; }

  /* ===== GAUGE ===== */
  .gauge-wrap { position: relative; width: 160px; margin: 0 auto; }
  .gauge-wrap canvas { display: block; }
  .gauge-text { position: absolute; bottom: 20px; left: 50%; transform: translateX(-50%); text-align: center; }
  .gauge-val { font-size: 24px; font-weight: 700; display: block; }
  .gauge-lbl { font-size: 11px; color: var(--text-muted); }

  /* ===== INFO CARD ===== */
  .info-card {
    background: var(--card-bg); border-radius: var(--radius);
    padding: 16px; box-shadow: var(--shadow);
  }

  /* ===== BACK BTN ===== */
  .back-btn {
    background: var(--primary); color: white;
    border: none; border-radius: var(--radius-sm);
    padding: 8px 18px; font-size: 13px; font-family: inherit;
    cursor: pointer; margin-bottom: 16px;
    display: inline-flex; align-items: center; gap: 8px;
    transition: background 0.2s;
  }
  .back-btn:hover { background: var(--accent); }

  /* ===== TOGGLE DETAIL ===== */
  .toggle-detail { cursor: pointer; }
  .toggle-detail .toggle-icon { transition: transform 0.2s; display: inline-block; }
  .toggle-detail.open .toggle-icon { transform: rotate(180deg); }

  /* ===== ROWS ===== */
  .row { display: flex; gap: 16px; margin-bottom: 16px; }
  .row > * { flex: 1; }
  .row .w2 { flex: 2; }
  .row .w3 { flex: 3; }

  /* ===== TABS CONTENT ===== */
  .card { background: var(--card-bg); border-radius: var(--radius); padding: 20px; box-shadow: var(--shadow); margin-bottom: 16px; }
  .card-header { display: flex; align-items: center; justify-content: space-between; margin-bottom: 14px; }
  .card-header-title { font-size: 15px; font-weight: 700; color: var(--primary); }

  /* ===== INTEGRATION MATRIX ===== */
  .integration-row { cursor: pointer; }
  .integration-detail { display: none; background: #f8fafc; }
  .integration-detail.open { display: table-row; }
  .integration-detail td { padding: 12px 14px 16px; }

  /* map/connections visual */
  .perf-map { display: grid; grid-template-columns: repeat(3, 1fr); gap: 12px; }
  .map-node {
    background: var(--card-bg); border-radius: var(--radius-sm);
    padding: 14px; box-shadow: var(--shadow);
    text-align: center; cursor: pointer; transition: all 0.2s;
    border: 2px solid transparent;
  }
  .map-node:hover { border-color: var(--accent); transform: scale(1.02); }
  .map-node .node-icon { font-size: 24px; margin-bottom: 6px; }
  .map-node .node-title { font-size: 12px; font-weight: 600; }
  .map-node .node-val { font-size: 20px; font-weight: 700; margin-top: 4px; }

  /* ===== PRIORITY BADGES ===== */
  .priority-high { background: #fee2e2; color: #991b1b; padding: 2px 8px; border-radius: 10px; font-size: 11px; font-weight: 600; }
  .priority-med { background: #fef3c7; color: #92400e; padding: 2px 8px; border-radius: 10px; font-size: 11px; font-weight: 600; }
  .priority-low { background: #dcfce7; color: #14532d; padding: 2px 8px; border-radius: 10px; font-size: 11px; font-weight: 600; }

  .btn-primary {
    background: var(--accent); color: white; border: none;
    padding: 8px 18px; border-radius: var(--radius-sm); font-family: inherit;
    font-size: 13px; cursor: pointer; font-weight: 600; transition: background 0.2s;
  }
  .btn-primary:hover { background: #b07a20; }

  .tag {
    display: inline-block; padding: 3px 8px; border-radius: 10px;
    font-size: 11px; font-weight: 600;
  }

  /* Data source status */
  .status-linked { background: #dcfce7; color: #14532d; }
  .status-update { background: #fef3c7; color: #92400e; }
  .status-incomplete { background: #fee2e2; color: #991b1b; }
  .status-unavail { background: #f1f5f9; color: #475569; }

  .mb-4 { margin-bottom: 16px; }
  .mb-8 { margin-bottom: 32px; }
  .mt-4 { margin-top: 16px; }
  .text-center { text-align: center; }
  .text-muted { color: var(--text-muted); }
  .text-small { font-size: 12px; }
  .font-bold { font-weight: 700; }
  .flex { display: flex; }
  .gap-2 { gap: 8px; }
  .items-center { align-items: center; }
  .justify-between { justify-content: space-between; }

  /* CHATBOT */
  .chat-widget { position: fixed; bottom: 32px; left: 32px; z-index: 2000; }
  .chat-trigger {
    width: 68px; height: 68px; border-radius: 22px; background: var(--primary);
    color: white; border: none; cursor: pointer; box-shadow: 0 12px 40px rgba(0,137,123,0.35);
    display: flex; align-items: center; justify-content: center; font-size: 28px;
    transition: all 0.3s cubic-bezier(0.175, 0.885, 0.32, 1.275);
  }
  .chat-trigger:hover { transform: scale(1.1) rotate(5deg); }
  
  .chat-panel {
    position: absolute; bottom: 85px; left: 0; width: 380px; height: 500px;
    background: var(--card-bg); backdrop-filter: blur(25px); border: 1px solid var(--border);
    border-radius: 24px; box-shadow: var(--shadow-lg); display: none; flex-direction: column;
    overflow: hidden; animation: slideIn 0.4s ease;
  }
  .chat-panel.active { display: flex; }
  @@keyframes slideIn { from { opacity:0; transform: translateY(20px); } to { opacity:1; transform: translateY(0); } }
  
  .chat-header { background: var(--primary); color: white; padding: 20px; font-weight: 700; display: flex; justify-content: space-between; }
  .chat-body { flex:1; padding: 20px; overflow-y: auto; display: flex; flex-direction: column; gap: 12px; }
  .chat-msg { padding: 12px 16px; border-radius: 18px; max-width: 85%; font-size: 13px; line-height: 1.5; }
  .chat-msg.bot { background: rgba(0,0,0,0.05); align-self: flex-start; border-bottom-right-radius: 4px; }
  [data-theme=dark] .chat-msg.bot { background: rgba(255,255,255,0.05); }
  .chat-msg.user { background: var(--primary); color: white; align-self: flex-end; border-bottom-left-radius: 4px; }
  .chat-input-area { padding: 16px; border-top: 1px solid var(--border); display: flex; gap: 10px; }
  .chat-input { flex:1; padding: 10px 16px; border-radius: 12px; border: 1px solid var(--border); background: var(--bg); font-family: inherit; outline: none; }

  /* ===== PRINT ===== */
  @@media print {
    .tabs-bar, .back-btn, .chat-widget { display: none; }
    .page { display: block !important; page-break-after: always; }
  }

  /* PRINT MEDIA QUERY FOR PDF EXPORT */
  @@media print {
    body { background: white !important; }
    .mesh-bg, .sidebar, .top-header, .chat-widget, .color-key { display: none !important; }
    .app-container { padding-right: 0 !important; }
    .main-wrapper { padding: 0 !important; }
    .page { display: block !important; page-break-after: always; max-width: 100% !important; animation: none !important; }
    .glass-card, .info-card, .kpi-card { box-shadow: none !important; border: 1px solid #e2e8f0 !important; background: white !important; }
    canvas { max-width: 100% !important; }
  }
  /* AI ANALYSIS CARD */
  .ai-analysis-card {
    background: linear-gradient(135deg, rgba(139, 92, 246, 0.05) 0%, rgba(14, 165, 233, 0.05) 100%);
    border: 1px solid rgba(139, 92, 246, 0.2);
    border-radius: 20px;
    padding: 20px;
    margin-top: 24px;
    position: relative;
    overflow: hidden;
  }
  .ai-analysis-card::before {
    content: '';
    position: absolute;
    top: 0; right: 0;
    width: 4px; height: 100%;
    background: linear-gradient(to bottom, #8b5cf6, #0ea5e9);
  }
  .ai-header {
    display: flex;
    justify-content: space-between;
    align-items: center;
    margin-bottom: 12px;
  }
  .ai-title {
    display: flex;
    align-items: center;
    gap: 8px;
    font-weight: 800;
    color: #8b5cf6;
    font-size: 14px;
  }
  .ai-content {
    font-size: 13px;
    line-height: 1.6;
    color: var(--text-secondary);
  }
  .ai-refresh-btn {
    background: white;
    border: 1px solid rgba(139, 92, 246, 0.3);
    color: #8b5cf6;
    padding: 4px 12px;
    border-radius: 8px;
    font-size: 11px;
    font-weight: 700;
    cursor: pointer;
    transition: 0.3s;
    display: flex;
    align-items: center;
    gap: 4px;
    border: none;
  }
  .ai-refresh-btn:hover {
    background: #8b5cf6;
    color: white;
  }
</style>
</head>
<body>
