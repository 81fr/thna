@code {
    private List<DashboardMetric> metrics = new();
    private Dictionary<string, double> MetricDict = new();

    private Dictionary<string, string> ModuleAnalyses = new();

    protected override async Task OnInitializedAsync()
    {
        using var db = DbFactory.CreateDbContext();
        metrics = await db.DashboardMetrics.ToListAsync();
        foreach(var m in metrics)
        {
            MetricDict[m.Key] = m.Value;
        }
        LoadInitialValues();
        await InitializeAIAnalyses();
    }

    private async Task InitializeAIAnalyses()
    {
        var keys = new[] { "summary", "map", "strategic", "operational", "hrperf", "risks", "financial", "governance", "excellence", "predictions", "integration", "decisions", "datasources", "attachments" };
        foreach(var k in keys)
        {
            ModuleAnalyses[k] = await AISvc.GetModuleAnalysisAsync(k);
        }
    }

    private async Task RefreshAI(string key)
    {
        ModuleAnalyses[key] = "جاري التحديث...";
        StateHasChanged();
        await Task.Delay(800); // Simulate processing
        ModuleAnalyses[key] = await AISvc.GetModuleAnalysisAsync(key);
        NotifySuccess($"تم تحديث تحليل الذكاء الاصطناعي لقسم {key}!");
    }

    private double GetMetric(string key, double defaultVal = 0)
    {
        return MetricDict.ContainsKey(key) ? MetricDict[key] : defaultVal;
    }

    // --- HR ---
    private double HrCompliance { get; set; } = 100;
    private double HrVolunteersActual { get; set; } = 756;
    private double HrVolunteersTarget { get; set; } = 1000;
    private double HrAutomation { get; set; } = 100;

    // --- Financial ---
    private double FinDonationsActual { get; set; } = 23469326;
    private double FinVolunteerReturnActual { get; set; } = 2450915;
    private double FinServicesReturnActual { get; set; } = 3223583;
    private double FinTotalIndex { get; set; } = 99.9;

    // --- Strategic ---
    private double StratBeneficiaries { get; set; } = 81.3;
    private double StratStakeholders { get; set; } = 100.0;
    private double StratFinancial { get; set; } = 99.9;
    private double StratOperations { get; set; } = 93.7;
    private double StratLearning { get; set; } = 93.9;

    // --- Operational ---
    private double OperInitiativesTotal { get; set; } = 158;
    private double OperInitiativesAchieved { get; set; } = 132;

    // --- Risks ---
    private double RiskLevelLow { get; set; } = 69;
    private double RiskLevelMedium { get; set; } = 13;
    private double RiskLevelHigh { get; set; } = 0;

    private void LoadInitialValues()
    {
        HrCompliance = GetMetric("HrCompliance", 100);
        HrVolunteersActual = GetMetric("HrVolunteersActual", 756);
        HrVolunteersTarget = GetMetric("HrVolunteersTarget", 1000);
        HrAutomation = GetMetric("HrAutomation", 100);

        FinDonationsActual = GetMetric("FinDonationsActual", 23469326);
        FinVolunteerReturnActual = GetMetric("FinVolunteerReturnActual", 2450915);
        FinServicesReturnActual = GetMetric("FinServicesReturnActual", 3223583);
        FinTotalIndex = GetMetric("FinTotalIndex", 99.9);

        StratBeneficiaries = GetMetric("StratBeneficiaries", 81.3);
        StratStakeholders = GetMetric("StratStakeholders", 100.0);
        StratFinancial = GetMetric("StratFinancial", 99.9);
        StratOperations = GetMetric("StratOperations", 93.7);
        StratLearning = GetMetric("StratLearning", 93.9);

        OperInitiativesTotal = GetMetric("OperInitiativesTotal", 158);
        OperInitiativesAchieved = GetMetric("OperInitiativesAchieved", 132);

        RiskLevelLow = GetMetric("RiskLevelLow", 69);
        RiskLevelMedium = GetMetric("RiskLevelMedium", 13);
        RiskLevelHigh = GetMetric("RiskLevelHigh", 0);
        
        StateHasChanged();
        UpdateJSData();
    }

    private void UpdateJSData()
    {
        var data = new {
            hr = new { compliance = HrCompliance, volunteers = HrVolunteersActual },
            fin = new { total = FinDonationsActual, index = FinTotalIndex },
            strat = new { beneficiaries = StratBeneficiaries, operations = StratOperations },
            risks = new { low = RiskLevelLow, med = RiskLevelMedium, high = RiskLevelHigh }
        };
        JS.InvokeVoidAsync("window.updateDashboardAIData", data);
    }

    private async Task SaveHrMetrics() { await SaveModule("HR", new[] { ("HrCompliance", HrCompliance), ("HrVolunteersActual", HrVolunteersActual), ("HrVolunteersTarget", HrVolunteersTarget), ("HrAutomation", HrAutomation) }, "hrLevelChart", HrCompliance); }
    private async Task SaveFinMetrics() { await SaveModule("Financial", new[] { ("FinDonationsActual", FinDonationsActual), ("FinVolunteerReturnActual", FinVolunteerReturnActual), ("FinServicesReturnActual", FinServicesReturnActual), ("FinTotalIndex", FinTotalIndex) }, "finCompChart", FinDonationsActual); }
    private async Task SaveStratMetrics() { await SaveModule("Strategic", new[] { ("StratBeneficiaries", StratBeneficiaries), ("StratStakeholders", StratStakeholders), ("StratFinancial", StratFinancial), ("StratOperations", StratOperations), ("StratLearning", StratLearning) }, "dimensionsChart", StratBeneficiaries); }
    private async Task SaveOperMetrics() { await SaveModule("Operational", new[] { ("OperInitiativesTotal", OperInitiativesTotal), ("OperInitiativesAchieved", OperInitiativesAchieved) }, "deptForecastChart", OperInitiativesAchieved); }
    private async Task SaveRiskMetrics() { await SaveModule("Risks", new[] { ("RiskLevelLow", RiskLevelLow), ("RiskLevelMedium", RiskLevelMedium), ("RiskLevelHigh", RiskLevelHigh) }, "riskLevelChart", RiskLevelLow); }

    private async Task SaveModule(string module, (string key, double val)[] items, string chartId, double chartVal)
    {
        foreach(var item in items) { await SaveMetric(module, item.key, item.val); }
        UpdateJSData();
        NotifySuccess($"تم حفظ بيانات {module} وتحديث الرسوم!");
        await JS.InvokeVoidAsync("updateDashboardChart", chartId, chartVal);
    }

    private void NotifySuccess(string msg) => ToastSvc.ShowSuccess(msg);

    private async Task SaveMetric(string module, string key, double value)
    {
        using var db = DbFactory.CreateDbContext();
        var metric = await db.DashboardMetrics.FirstOrDefaultAsync(m => m.Key == key);
        if(metric == null) { db.DashboardMetrics.Add(new DashboardMetric { Module = module, Key = key, Value = value, LastUpdated = DateTime.Now }); }
        else { metric.Value = value; metric.LastUpdated = DateTime.Now; }
        await db.SaveChangesAsync();
        MetricDict[key] = value;
    }
}