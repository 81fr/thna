function getClass(v) {
  if (v >= 90) return 'excellent';
  if (v >= 70) return 'good';
  if (v < 70) return 'weak';
  return 'pending';
}
function getBadge(v) {
  if (v >= 90) return '<span class="kpi-badge badge-excellent">ممتاز</span>';
  if (v >= 70) return '<span class="kpi-badge badge-good">جيد</span>';
  return '<span class="kpi-badge badge-weak">ضعيف</span>';
}

