window.updateDashboardChart = function(chartId, newValue) {
  const chart = Chart.getChart(chartId);
  if(chart) {
    chart.data.datasets[0].data[0] = newValue;
    chart.update();
  }
};

function showTab(tabId) {
  // Hide all pages
  document.querySelectorAll('.page').forEach(p => p.classList.remove('active'));
  
  // Update Sidebar active state
  document.querySelectorAll('.nav-item').forEach(item => {
    item.classList.remove('active');
    if (item.getAttribute('onclick') && item.getAttribute('onclick').includes(`'${tabId}'`)) {
      item.classList.add('active');
    }
  });

  const tabMap = {
    cover:'page-cover', summary:'page-summary', map:'page-map',
    strategic:'page-strategic', operational:'page-operational',
    hrperf:'page-hrperf', risks:'page-risks', financial:'page-financial',
    governance:'page-governance', excellence:'page-excellence',
    predictions:'page-predictions', integration:'page-integration', 
    decisions:'page-decisions', datasources:'page-datasources', 
    attachments:'page-attachments'
  };

  const targetId = tabMap[tabId] || 'page-' + tabId;
  const targetPage = document.getElementById(targetId);
  if (targetPage) {
    targetPage.classList.add('active');
  }

  window.scrollTo(0, 0);
}

function toggleChat() { document.getElementById('chatPanel').classList.toggle('active'); }

function sendChat() {
  const input = document.getElementById('chatInput');
  const body = document.getElementById('chatBody');
  if(!input.value.trim()) return;
  
  const uMsg = document.createElement('div');
  uMsg.className = 'chat-msg user';
  uMsg.innerText = input.value;
  body.appendChild(uMsg);
  
  const q = input.value.toLowerCase();
  input.value = '';
  body.scrollTop = body.scrollHeight;

  const data = window.DASHBOARD_DATA || {};

  setTimeout(() => {
    const bMsg = document.createElement('div');
    bMsg.className = 'chat-msg bot';
    let reply = "أقوم حالياً بتحليل البيانات... الأداء الاستراتيجي العام للربع الأول هو " + (data.strat?.beneficiaries || "90.1") + "% وهو فوق المستهدف.";
