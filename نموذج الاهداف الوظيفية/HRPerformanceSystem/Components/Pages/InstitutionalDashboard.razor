function buildDeptTable() {
  const tbody = document.getElementById('deptTableBody');
  if(!tbody) return;
  tbody.innerHTML = DEPTS.map(d => {
    const cls = getClass(d.total);
    const bar = `<div class="progress-bar-wrap"><div class="progress-bar-fill fill-${cls}" style="width:${d.total}%"></div></div>`;
    return `<tr>
      <td>${d.name}</td>
      <td>${d.total}%<br>${bar}</td>
      <td>${d.init ? d.init+'%' : '—'}</td>
      <td>${d.docs ? d.docs+'%' : '—'}</td>
      <td>${getBadge(d.total)}</td>
      <td style="font-size:11px;color:var(--text-muted)">${d.total<70?'يحتاج متابعة عاجلة':d.total<90?'يحتاج تطوير':''}</td>
    </tr>`;
  }).join('');
}

