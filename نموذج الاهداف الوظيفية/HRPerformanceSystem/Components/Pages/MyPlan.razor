@page "/my-plan"
@attribute [Authorize(Roles = "Admin, HR, Employee, Leader")]
@rendermode InteractiveServer
@using HRPerformanceSystem.Data
@using HRPerformanceSystem.Models
@using HRPerformanceSystem.Services
@using Microsoft.EntityFrameworkCore
@using System.Security.Claims
@inject IDbContextFactory<ApplicationDbContext> DbFactory
@inject AuthenticationStateProvider AuthStateProvider
@inject NavigationManager Nav
@inject AIInsightsService AISvc
@inject CalculationService Calc

<div class="employee-dashboard animate-in">
    @if (isLoading)
    {
        <div class="premium-loader">
            <div class="loader-content">
                <div class="spinner"></div>
                <span>جاري تحضير ملفك الوظيفي...</span>
            </div>
        </div>
    }
    else if (employee == null)
    {
        <div class="card glass-card error-card">
            <Icon Name="alert-circle" Size="48" Color="var(--danger)" />
            <h2>تنبيه النظام</h2>
            <p>حسابك غير مرتبط بملف موظف في قاعدة البيانات. يرجى التواصل مع إدارة الموارد البشرية لربط الرقم الوظيفي.</p>
        </div>
    }
    else
    {
        <!-- Header Section -->
        <div class="dashboard-header card glass-card">
            <div class="header-profile">
                <div class="avatar-wrapper">
                    <div class="avatar-large">@employee.FullName.Substring(0, 1)</div>
                    <div class="status-indicator online"></div>
                </div>
                <div class="profile-info">
                    <div class="greeting">@AISvc.GetSmartGreeting()، @employee.FullName</div>
                    <div class="position-meta">
                        <span><Icon Name="briefcase" Size="16" /> @employee.JobTitle</span>
                        <span class="dot"></span>
                        <span><Icon Name="map-pin" Size="16" /> @employee.Department</span>
                        <span class="dot"></span>
                        <span><Icon Name="hash" Size="16" /> @employee.EmployeeNumber</span>
                    </div>
                </div>
            </div>
            <div class="header-actions">
                <button class="btn btn-premium-outline" @onclick='() => activeTab = "discussion"'>
                    <Icon Name="message-square" Size="18" />
                    <span>المناقشة (@(evaluation?.Comments.Count ?? 0))</span>
                </button>
                <button class="btn btn-premium-outline" @onclick="DownloadPlan">
                    <Icon Name="download" Size="18" />
                    <span>تحميل (PDF)</span>
                </button>
            </div>
        </div>

        <div class="dashboard-grid">
            <!-- Left Column: Main Content -->
            <div class="main-column">
                
                @if (evaluation == null)
                {
                    <div class="card glass-card empty-plan-card">
                        <div class="empty-icon"><Icon Name="folder-plus" Size="64" /></div>
                        <h3>ميثاق الأداء لعام @DateTime.Now.Year</h3>
                        <p>لم يتم إنشاء ميثاق الأداء الخاص بك لهذا العام بعد. ابدأ الآن بتحديد أهدافك السنوية.</p>
                        <button class="btn btn-primary btn-lg" @onclick="CreateEvaluation">
                            <Icon Name="plus" Size="20" /> إنشاء ميثاق الأهداف الآن
                        </button>
                    </div>
                }
                else
                {
                    <!-- Tabs Navigation -->
                    <div class="tabs-nav card glass-card">
                        <button class="tab-item @(activeTab == "goals" ? "active" : "")" @onclick='() => activeTab = "goals"'>
                            <Icon Name="target" Size="18" /> ميثاق الأهداف
                        </button>
                        @if (myImprovementPlans.Any())
                        {
                            <button class="tab-item @(activeTab == "pip" ? "active" : "")" @onclick='() => activeTab = "pip"'>
                                <Icon Name="trending-up" Size="18" /> 
                                خطة التطوير
                                <span class="badge-dot pulse"></span>
                            </button>
                        }
                        <button class="tab-item @(activeTab == "competencies" ? "active" : "")" @onclick='() => activeTab = "competencies"'>
                            <Icon Name="award" Size="18" /> الجدارات
                        </button>
                        <button class="tab-item @(activeTab == "discussion" ? "active" : "")" @onclick='() => activeTab = "discussion"'>
                            <Icon Name="message-circle" Size="18" /> المناقشة
                        </button>
                    </div>

                    <div class="tab-content animate-in">
                        @if (activeTab == "goals")
                        {
                            <div class="goals-list-wrapper">
                                <div class="section-header">
                                    <h3>أهدافي الوظيفية</h3>
                                    @if (evaluation.Status == EvaluationStatus.Draft)
                                    {
                                        <button class="btn btn-sm btn-outline-primary" @onclick="AddGoal">
                                            <Icon Name="plus" Size="14" /> إضافة هدف جديد
                                        </button>
                                    }
                                    else
                                    {
                                        <span class="status-badge @evaluation.Status.ToString().ToLower()">ميثاق @(evaluation.Status == EvaluationStatus.Approved ? "معتمد" : "قيد المراجعة")</span>
                                    }
                                </div>

                                @if (!evaluation.Goals.Any())
                                {
                                    <div class="empty-goals">
                                        <p>لا توجد أهداف مضافة حالياً.</p>
                                    </div>
                                }
                                else
                                {
                                    <div class="goals-grid">
                                        @foreach (var goal in evaluation.Goals.OrderBy(g => g.DisplayOrder))
                                        {
                                            <div class="goal-premium-card card">
                                                <div class="goal-header">
                                                    <div class="goal-title-group">
                                                        <span class="goal-index">#@goal.DisplayOrder</span>
                                                        <h4>@goal.GoalDescription</h4>
                                                    </div>
                                                    <div class="goal-actions">
                                                        @if (evaluation.Status == EvaluationStatus.Draft)
                                                        {
                                                            <button class="icon-btn" @onclick="() => EditGoal(goal)"><Icon Name="edit" Size="16" /></button>
                                                            <button class="icon-btn danger" @onclick="() => DeleteGoal(goal)"><Icon Name="trash" Size="16" /></button>
                                                        }
                                                    </div>
                                                </div>
                                                
                                                <div class="goal-body">
                                                    <div class="goal-meta-grid">
                                                        <div class="meta-item"><label>الوزن</label><div class="val">@goal.Weight%</div></div>
                                                        <div class="meta-item"><label>المستهدف</label><div class="val">@goal.AnnualTarget</div></div>
                                                        <div class="meta-item"><label>الإنجاز</label><div class="val primary">@goal.CalculateCompletionPercentage().ToString("F1")%</div></div>
                                                    </div>
                                                    <div class="progress-container">
                                                        @{ var progress = goal.CalculateCompletionPercentage(); }
                                                        <div class="progress-track"><div class="progress-fill" style="width: @(Math.Min(progress, 100))%;"></div></div>
                                                    </div>
                                                </div>
                                            </div>
                                        }
                                    </div>
                                }

                                @if (evaluation.Status == EvaluationStatus.Draft)
                                {
                                    <div class="submit-section card glass-card">
                                        <div class="submit-info">
                                            <div class="total-weight @(TotalWeight == 65 ? "success" : "warning")">إجمالي الأوزان: <strong>@TotalWeight% / 65%</strong></div>
                                        </div>
                                        <button class="btn btn-primary" @onclick="SubmitForReview" disabled="@(TotalWeight != 65)">
                                            <Icon Name="send" Size="18" /> إرسال للمدير
                                        </button>
                                    </div>
                                }
                            </div>
                        }
                        else if (activeTab == "pip")
                        {
                            <div class="pip-container animate-in">
                                @foreach (var plan in myImprovementPlans)
                                {
                                    <div class="pip-hero card glass-card">
                                        <div class="pip-badge-ai"><Icon Name="cpu" Size="14" /> مسار تطوير ذكي</div>
                                        <h2>خطة تطوير الأداء: @plan.SourceItem</h2>
                                        <div class="pip-stats">
                                            <div class="p-stat"><label>الحالي</label><div class="v">@plan.CurrentScore%</div></div>
                                            <div class="p-stat"><label>المستهدف</label><div class="v">@plan.TargetScore%</div></div>
                                            <div class="p-stat"><label>الإنجاز</label><div class="v success">@plan.ProgressPercentage%</div></div>
                                        </div>
                                    </div>

                                    <div class="pip-tasks-grid">
                                        @foreach (var task in plan.ExecutiveTasks)
                                        {
                                            <div class="task-card card @(task.Status == "مكتمل" ? "completed" : "")" @onclick="() => ToggleTaskStatus(task)">
                                                <div class="task-check">
                                                    @if (task.Status == "مكتمل") { <Icon Name="check-circle" Size="24" Color="var(--success)" /> }
                                                    else if (task.Status == "قيد التنفيذ") { <Icon Name="clock" Size="24" Color="var(--warning)" /> }
                                                    else { <div class="check-placeholder"></div> }
                                                </div>
                                                <div class="task-info">
                                                    <h5>@task.Title</h5>
                                                    <p>@task.Description</p>
                                                    <div class="task-meta">
                                                        <span><Icon Name="calendar" Size="14" /> @task.Deadline</span>
                                                    </div>
                                                </div>
                                            </div>
                                        }
                                    </div>
                                }
                            </div>
                        }
                        else if (activeTab == "discussion")
                        {
                            <div class="discussion-container animate-in">
                                <div class="card glass-card chat-wrapper">
                                    <div class="chat-header">
                                        <div class="chat-title">
                                            <Icon Name="users" Size="20" />
                                            <span>مساحة النقاش التشاركي</span>
                                        </div>
                                        <div class="collaborators">
                                            <div class="collab-avatar" title="@employee.FullName">@employee.FullName.Substring(0,1)</div>
                                            <div class="collab-avatar manager" title="@employee.DirectManager">M</div>
                                        </div>
                                    </div>
                                    
                                    <div class="chat-messages" id="chatMessages">
                                        @if (!evaluation.Comments.Any())
                                        {
                                            <div class="empty-chat">
                                                <Icon Name="message-square" Size="48" Color="var(--border)" />
                                                <p>لا توجد مناقشات حالياً. ابدأ بمشاركة ملاحظاتك مع مديرك المباشر.</p>
                                            </div>
                                        }
                                        else
                                        {
                                            @foreach (var comment in evaluation.Comments.OrderBy(c => c.CreatedAt))
                                            {
                                                <div class="message @(comment.UserId == userId ? "own" : "other")">
                                                    <div class="msg-bubble">
                                                        <div class="msg-header">
                                                            <span class="msg-author">@comment.UserName</span>
                                                            <span class="msg-time">@comment.CreatedAt.ToString("t")</span>
                                                        </div>
                                                        <div class="msg-content">@comment.Content</div>
                                                    </div>
                                                </div>
                                            }
                                        }
                                    </div>
                                    
                                    <div class="chat-input-area">
                                        <textarea @bind="newComment" @bind:event="oninput" @onkeyup="HandleKeyUp" placeholder="اكتب ملاحظة أو استفسار هنا..." rows="1"></textarea>
                                        <button class="btn btn-primary btn-icon" @onclick="SendComment" disabled="@string.IsNullOrWhiteSpace(newComment)">
                                            <Icon Name="send" Size="20" />
                                        </button>
                                    </div>
                                </div>
                                
                                <div class="discussion-guidelines card glass-card">
                                    <h5><Icon Name="info" Size="16" /> نصائح للمشاركة الفعالة</h5>
                                    <ul>
                                        <li>ركز على النتائج المحققة والتحديات التي واجهتك.</li>
                                        <li>اطلب التوجيه (Coaching) في الجدارات التي ترغب بتطويرها.</li>
                                        <li>وثق الاتفاقات الجانبية التي تتم مع مديرك هنا لضمان حفظ الحقوق.</li>
                                    </ul>
                                </div>
                            </div>
                        }
                    </div>
                }
            </div>

            <!-- Right Column -->
            <div class="side-column">
                <div class="card glass-card performance-summary-card">
                    <div class="card-title">ملخص الأداء</div>
                    <div class="score-circle-wrapper">
                        <svg viewBox="0 0 36 36" class="circular-chart @(GetScoreColorClass())">
                            <path class="circle-bg" d="M18 2.0845 a 15.9155 15.9155 0 0 1 0 31.831 a 15.9155 15.9155 0 0 1 0 -31.831" />
                            <path class="circle" stroke-dasharray="@(evaluation?.FinalScore ?? 0), 100" d="M18 2.0845 a 15.9155 15.9155 0 0 1 0 31.831 a 15.9155 15.9155 0 0 1 0 -31.831" />
                            <text x="18" y="20.35" class="percentage">@(evaluation?.FinalScore.ToString("F0") ?? "0")%</text>
                        </svg>
                    </div>
                    <div class="rating-text">@Calc.GetRating(evaluation?.FinalScore ?? 0)</div>
                </div>

                <div class="card glass-card status-info-card">
                    <div class="card-title">تتبع الاعتماد</div>
                    <div class="status-timeline">
                        <div class="timeline-item @(evaluation != null ? "completed" : "")"><div class="t-icon"><Icon Name="edit" Size="12" /></div><div class="t-text">المسودة</div></div>
                        <div class="timeline-item @(evaluation?.Status >= EvaluationStatus.InReview ? "completed" : "")"><div class="t-icon"><Icon Name="send" Size="12" /></div><div class="t-text">المراجعة</div></div>
                        <div class="timeline-item @(evaluation?.Status == EvaluationStatus.Approved ? "completed" : "")"><div class="t-icon"><Icon Name="check" Size="12" /></div><div class="t-text">الاعتماد</div></div>
                    </div>
                </div>
            </div>
        </div>
    }
</div>

@if (showGoalModal)
{
    <div class="modal-backdrop animate-in" @onclick="CloseGoalModal">
        <div class="modal glass-modal" @onclick:stopPropagation="true">
            <div class="modal-header">
                <h3>@(editingGoal.Id == 0 ? "هدف جديد" : "تعديل")</h3>
                <button class="close-btn" @onclick="CloseGoalModal">✕</button>
            </div>
            <div class="modal-body">
                <div class="form-group"><label>الوصف</label><textarea class="form-control" @bind="editingGoal.GoalDescription" rows="3"></textarea></div>
                <div class="form-row">
                    <div class="form-group"><label>الوزن (%)</label><input type="number" class="form-control" @bind="editingGoal.Weight" /></div>
                    <div class="form-group"><label>المستهدف</label><input type="number" class="form-control" @bind="editingGoal.AnnualTarget" /></div>
                </div>
            </div>
            <div class="modal-footer">
                <button class="btn btn-primary" @onclick="SaveGoal">حفظ</button>
            </div>
        </div>
    </div>
}

<style>
    .employee-dashboard { max-width: 1400px; margin: 0 auto; padding: 20px; display: flex; flex-direction: column; gap: 24px; }
    .glass-card { background: rgba(255, 255, 255, 0.7); backdrop-filter: blur(12px); border: 1px solid rgba(255, 255, 255, 0.4); border-radius: 24px; }
    .dashboard-header { padding: 24px 32px; display: flex; justify-content: space-between; align-items: center; }
    .header-profile { display: flex; gap: 24px; align-items: center; }
    .avatar-large { width: 70px; height: 70px; border-radius: 20px; background: linear-gradient(135deg, var(--primary), var(--accent)); color: white; display: flex; align-items: center; justify-content: center; font-size: 1.8rem; font-weight: 900; }
    .dashboard-grid { display: grid; grid-template-columns: 1fr 350px; gap: 24px; }
    .tabs-nav { padding: 8px; display: flex; gap: 8px; margin-bottom: 24px; }
    .tab-item { flex: 1; padding: 12px; border: none; background: transparent; border-radius: 16px; color: var(--text-secondary); font-weight: 700; cursor: pointer; transition: 0.3s; display: flex; align-items: center; justify-content: center; gap: 8px; }
    .tab-item.active { background: white; color: var(--primary); box-shadow: var(--shadow-sm); }
    
    /* Discussion / Chat */
    .chat-wrapper { height: 600px; display: flex; flex-direction: column; overflow: hidden; margin-bottom: 20px; }
    .chat-header { padding: 20px; border-bottom: 1px solid var(--border-light); display: flex; justify-content: space-between; align-items: center; background: rgba(255,255,255,0.4); }
    .chat-title { display: flex; gap: 10px; align-items: center; font-weight: 800; color: var(--primary); }
    .collaborators { display: flex; }
    .collab-avatar { width: 32px; height: 32px; border-radius: 50%; border: 2px solid white; background: var(--accent); color: white; display: flex; align-items: center; justify-content: center; font-size: 0.7rem; font-weight: 800; margin-left: -10px; }
    .collab-avatar.manager { background: var(--primary); }
    
    .chat-messages { flex: 1; overflow-y: auto; padding: 24px; display: flex; flex-direction: column; gap: 16px; background: rgba(248, 250, 252, 0.5); }
    .empty-chat { text-align: center; margin-top: 100px; color: var(--text-muted); }
    
    .message { display: flex; width: 100%; }
    .message.own { justify-content: flex-start; }
    .message.other { justify-content: flex-end; }
    .msg-bubble { max-width: 80%; padding: 12px 18px; border-radius: 20px; font-size: 0.95rem; line-height: 1.5; }
    .own .msg-bubble { background: white; border: 1px solid var(--border-light); border-top-right-radius: 4px; }
    .other .msg-bubble { background: var(--primary); color: white; border-top-left-radius: 4px; }
    
    .msg-header { display: flex; justify-content: space-between; gap: 20px; margin-bottom: 4px; font-size: 0.75rem; font-weight: 700; opacity: 0.8; }
    .chat-input-area { padding: 20px; background: white; border-top: 1px solid var(--border-light); display: flex; gap: 12px; align-items: center; }
    .chat-input-area textarea { flex: 1; border: 1px solid var(--border-light); border-radius: 12px; padding: 12px; resize: none; font-family: inherit; font-size: 0.9rem; }
    .btn-icon { width: 45px; height: 45px; border-radius: 12px; display: flex; align-items: center; justify-content: center; }

    .discussion-guidelines { padding: 20px; }
    .discussion-guidelines h5 { font-weight: 800; margin-bottom: 12px; color: var(--text-primary); }
    .discussion-guidelines ul { padding-right: 20px; font-size: 0.85rem; color: var(--text-secondary); }
    .discussion-guidelines li { margin-bottom: 8px; }

    /* Reuse Progress & Score Styles */
    .circular-chart { width: 150px; margin: 0 auto; }
    .circle-bg { fill: none; stroke: #eee; stroke-width: 3; }
    .circle { fill: none; stroke-width: 3; stroke-linecap: round; }
    .circular-chart.success .circle { stroke: var(--success); }
    .percentage { font-size: 0.5rem; text-anchor: middle; font-weight: 900; }
    .rating-text { text-align: center; font-weight: 900; font-size: 1.2rem; margin-top: 10px; }

    .animate-in { animation: slideUp 0.4s ease-out; }
    @@keyframes slideUp { from { opacity: 0; transform: translateY(15px); } to { opacity: 1; transform: translateY(0); } }
</style>

@code {
    bool isLoading = true;
    string? userId;
    Employee? employee;
    PerformanceEvaluation? evaluation;
    List<ImprovementPlan> myImprovementPlans = new();
    string activeTab = "goals";
    string newComment = "";
    
    bool showGoalModal;
    ObjectiveGoal editingGoal = new();
    double TotalWeight => evaluation?.Goals.Sum(g => g.Weight) ?? 0;

    protected override async Task OnInitializedAsync()
    {
        var authState = await AuthStateProvider.GetAuthenticationStateAsync();
        userId = authState.User.FindFirst(ClaimTypes.NameIdentifier)?.Value;
        await LoadData();
    }

    async Task LoadData()
    {
        using var db = DbFactory.CreateDbContext();
        employee = await db.Employees.FirstOrDefaultAsync(e => e.UserId == userId && !e.IsDeleted);
        if (employee != null)
        {
            evaluation = await db.Evaluations
                .Include(e => e.Goals)
                .Include(e => e.Competencies)
                .Include(e => e.Comments)
                .FirstOrDefaultAsync(e => e.EmployeeId == employee.Id && e.Year == DateTime.Now.Year && !e.IsDeleted);

            await AISvc.SyncPlansForEmployeeAsync(employee.Id);
            myImprovementPlans = await AISvc.GetActivePlansAsync(employee.Id);
        }
        isLoading = false;
    }

    async Task SendComment()
    {
        if (string.IsNullOrWhiteSpace(newComment) || evaluation == null) return;

        using var db = DbFactory.CreateDbContext();
        var comment = new EvaluationComment
        {
            EvaluationId = evaluation.Id,
            UserId = userId ?? "",
            UserName = employee?.FullName ?? "موظف",
            Content = newComment,
            IsManager = false
        };

        db.EvaluationComments.Add(comment);
        await db.SaveChangesAsync();
        
        evaluation.Comments.Add(comment);
        newComment = "";
        StateHasChanged();
    }

    void HandleKeyUp(KeyboardEventArgs e) { if (e.Key == "Enter" && !e.ShiftKey) SendComment(); }

    async Task ToggleTaskStatus(ImprovementTask task)
    {
        string next = task.Status switch { "مجدول" => "قيد التنفيذ", "قيد التنفيذ" => "مكتمل", _ => "مجدول" };
        await AISvc.UpdateTaskStatusAsync(task.Id, next);
        task.Status = next;
    }

    async Task SubmitForReview()
    {
        if (evaluation == null) return;
        using var db = DbFactory.CreateDbContext();
        var eval = await db.Evaluations.FindAsync(evaluation.Id);
        if (eval != null) { eval.Status = EvaluationStatus.InReview; await db.SaveChangesAsync(); await LoadData(); }
    }

    string GetScoreColorClass() => (evaluation?.FinalScore ?? 0) >= 80 ? "success" : "warning";
    async Task CreateEvaluation() 
    { 
        if (employee == null) return;
        
        using var db = DbFactory.CreateDbContext();
        var newEval = new PerformanceEvaluation
        {
            EmployeeId = employee.Id,
            Year = DateTime.Now.Year,
            Status = EvaluationStatus.Draft,
            ReviewerName = employee.DirectManager ?? "المدير المباشر",
            CreatedAt = DateTime.Now,
            UpdatedAt = DateTime.Now
        };
        
        db.Evaluations.Add(newEval);
        await db.SaveChangesAsync();
        
        await LoadData();
        StateHasChanged();
    }
    void AddGoal() { editingGoal = new() { EvaluationId = evaluation!.Id, Weight = 5, AnnualTarget = 100 }; showGoalModal = true; }
    
    void EditGoal(ObjectiveGoal g) { editingGoal = new ObjectiveGoal { Id = g.Id, EvaluationId = g.EvaluationId, GoalDescription = g.GoalDescription, Weight = g.Weight, AnnualTarget = g.AnnualTarget, DisplayOrder = g.DisplayOrder }; showGoalModal = true; }
    
    void CloseGoalModal() => showGoalModal = false;
    
    async Task SaveGoal() 
    { 
        if (evaluation == null || string.IsNullOrWhiteSpace(editingGoal.GoalDescription)) return;
        
        using var db = DbFactory.CreateDbContext();
        if (editingGoal.Id == 0)
        {
            editingGoal.DisplayOrder = (evaluation.Goals.Count > 0 ? evaluation.Goals.Max(g => g.DisplayOrder) : 0) + 1;
            db.Goals.Add(editingGoal);
        }
        else
        {
            var existing = await db.Goals.FindAsync(editingGoal.Id);
            if (existing != null)
            {
                existing.GoalDescription = editingGoal.GoalDescription;
                existing.Weight = editingGoal.Weight;
                existing.AnnualTarget = editingGoal.AnnualTarget;
                db.Update(existing);
            }
        }
        await db.SaveChangesAsync();
        await LoadData();
        CloseGoalModal();
    }
    
    async Task DeleteGoal(ObjectiveGoal g) 
    { 
        using var db = DbFactory.CreateDbContext();
        var toDelete = await db.Goals.FindAsync(g.Id);
        if (toDelete != null)
        {
            db.Goals.Remove(toDelete);
            await db.SaveChangesAsync();
            await LoadData();
        }
    }
    
    async Task DownloadPlan() { Nav.NavigateTo($"/api/export/employee/{evaluation?.Id}", true); }
}
