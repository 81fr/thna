@page "/evaluations/new"
@page "/evaluations/edit/{EvalId:int}"
@attribute [Authorize(Roles = "Admin, HR, Manager")]
@rendermode InteractiveServer
@using HRPerformanceSystem.Data
@using HRPerformanceSystem.Models
@using HRPerformanceSystem.Services
@using Microsoft.EntityFrameworkCore
@using System.Text.Json
@inject IDbContextFactory<ApplicationDbContext> DbFactory
@inject CalculationService CalcService
@inject NavigationManager Nav
@inject AuditService AuditSvc
@inject NotificationService NotifSvc
@inject IWebHostEnvironment Env

<div class="evaluation-editor animate-in">
    @if (isLoading)
    {
        <div class="premium-loader">
            <div class="loader-content"><div class="spinner"></div><span>جاري تحميل الميثاق...</span></div>
        </div>
    }
    else
    {
        <div class="page-header card glass-card">
            <div class="header-main">
                <div class="ai-badge-header"><Icon Name="sparkles" Size="14" /> ميثاق أداء احترافي</div>
                <h1>
                    @(isEdit ? "تعديل ميثاق الأداء" : "إعداد ميثاق أداء جديد")
                    <Icon Name="@(isEdit ? "edit" : "plus-circle")" Size="28" Color="var(--primary)" />
                </h1>
                <div class="subtitle">السنة المالية @evaluation.Year | @(evaluation.EmployeeId > 0 ? employees.First(e => e.Id == evaluation.EmployeeId).FullName : "بانتظار اختيار الموظف")</div>
            </div>
            <div class="header-actions">
                @if (isEdit)
                {
                    <button class="btn btn-premium-outline" @onclick='() => Nav.NavigateTo($"/evaluations/view/{EvalId}")'>
                        <Icon Name="eye" Size="18" /> معاينة
                    </button>
                }
                <button class="btn btn-primary" @onclick="SaveEvaluation">
                    <Icon Name="save" Size="18" /> حفظ التغييرات
                </button>
            </div>
        </div>

        @if (!isEdit && !wizardComplete)
        {
            <!-- Wizard Step 1: Initialization -->
            <div class="wizard-container card glass-card animate-in">
                <div class="wizard-header">
                    <div class="step-indicator active">1</div>
                    <div class="step-line"></div>
                    <div class="step-indicator">2</div>
                </div>
                
                <div class="wizard-body">
                    <h2>لنبدأ بإعداد الميثاق الجديد</h2>
                    <p>اختر الموظف ونوع الميثاق المناسب له لبدء التخطيط السنوي.</p>
                    
                    <div class="wizard-form">
                        <div class="form-group">
                            <label>الموظف المستهدف</label>
                            <select class="form-control premium-select" @bind="evaluation.EmployeeId">
                                <option value="0">-- اختر موظفاً من القائمة --</option>
                                @foreach (var emp in employees) { <option value="@emp.Id">@emp.FullName (@emp.JobTitle)</option> }
                            </select>
                        </div>
                        
                        <div class="template-selector">
                            <label>اختر نموذجاً للبداية السريعة</label>
                            <div class="template-grid">
                                <div class="template-card @(selectedTemplate == "employee" ? "active" : "")" @onclick='() => selectedTemplate = "employee"'>
                                    <Icon Name="user" Size="32" />
                                    <h4>ميثاق وظيفي</h4>
                                    <p>للأدوار التخصصية والفنية</p>
                                </div>
                                <div class="template-card @(selectedTemplate == "leader" ? "active" : "")" @onclick='() => selectedTemplate = "leader"'>
                                    <Icon Name="users" Size="32" />
                                    <h4>ميثاق قيادي</h4>
                                    <p>لمدراء الإدارات والأقسام</p>
                                </div>
                                <div class="template-card @(selectedTemplate == "excel" ? "active" : "")" @onclick='() => selectedTemplate = "excel"'>
                                    <Icon Name="file-spreadsheet" Size="32" />
                                    <h4>رفع من ملف (Excel)</h4>
                                    <p>استيراد البيانات من ملف خارجي</p>
                                </div>
                            </div>
                        </div>
                    </div>
                    
                    <div class="wizard-footer">
                        <button class="btn btn-lg btn-primary" @onclick="ProceedWizard" disabled="@(evaluation.EmployeeId == 0)">
                            متابعة الإعداد <Icon Name="arrow-left" Size="20" />
                        </button>
                    </div>
                </div>
            </div>
        }
        else
        {
            <div class="editor-grid">
                <!-- Sidebar: Status & Info -->
                <div class="editor-sidebar">
                    <div class="card glass-card info-card">
                        <div class="card-title">حالة الميثاق</div>
                        <select class="form-control status-select" @bind="evaluation.Status">
                            <option value="@EvaluationStatus.Draft">مسودة (Draft)</option>
                            <option value="@EvaluationStatus.InReview">قيد المراجعة (Review)</option>
                            <option value="@EvaluationStatus.Approved">معتمد (Approved)</option>
                        </select>
                        
                        <div class="score-display">
                            <label>النتيجة الحالية</label>
                            <div class="score-val" style="color: @CalcService.GetRatingColor(evaluation.FinalScore)">@evaluation.FinalScore.ToString("F1")%</div>
                            <div class="rating-tag" style="background: @(CalcService.GetRatingColor(evaluation.FinalScore))15; color: @CalcService.GetRatingColor(evaluation.FinalScore)">
                                @CalcService.GetRating(evaluation.FinalScore)
                            </div>
                        </div>
                    </div>

                    <div class="card glass-card weight-distribution">
                        <div class="card-title">توزيع الأوزان</div>
                        <div class="weight-item">
                            <div class="w-label">الأهداف (65%)</div>
                            <div class="w-progress"><div class="w-fill @(GoalsWeight == 65 ? "ok" : "err")" style="width: @(Math.Min(100, GoalsWeight/0.65))%"></div></div>
                            <div class="w-val">@GoalsWeight%</div>
                        </div>
                        <div class="weight-item">
                            <div class="w-label">الجدارات (35%)</div>
                            <div class="w-progress"><div class="w-fill @(CompsWeight == 35 ? "ok" : "err")" style="width: @(Math.Min(100, CompsWeight/0.35))%"></div></div>
                            <div class="w-val">@CompsWeight%</div>
                        </div>
                    </div>
                </div>

                <!-- Main Area -->
                <div class="editor-main">
                    <div class="tabs-nav card glass-card">
                        <button class="tab-item @(activeTab == "goals" ? "active" : "")" @onclick='() => activeTab = "goals"'>
                            <Icon Name="target" Size="18" /> الأهداف الذكية
                        </button>
                        <button class="tab-item @(activeTab == "comps" ? "active" : "")" @onclick='() => activeTab = "comps"'>
                            <Icon Name="award" Size="18" /> الجدارات
                        </button>
                        <button class="tab-item @(activeTab == "monitoring" ? "active" : "")" @onclick='() => activeTab = "monitoring"'>
                            <Icon Name="bar-chart" Size="18" /> المتابعة والنتائج
                        </button>
                    </div>

                    <div class="tab-content animate-in">
                        @if (activeTab == "goals")
                        {
                            <div class="goals-section">
                                <div class="section-actions">
                                    <button class="btn btn-sm btn-outline-primary" @onclick="AddGoal"><Icon Name="plus" Size="16" /> إضافة هدف</button>
                                    <button class="btn btn-sm btn-ai" @onclick="AutoEnhanceAll"><Icon Name="sparkles" Size="16" /> تحسين الكل بالذكاء الاصطناعي</button>
                                </div>

                                @foreach (var goal in goals)
                                {
                                    <div class="goal-editor-card card animate-in">
                                        <div class="goal-card-header">
                                            <span class="g-index">#@goal.DisplayOrder</span>
                                            <textarea class="goal-text" @bind="goal.GoalDescription" placeholder="ادخل وصف الهدف..."></textarea>
                                            <button class="icon-btn danger" @onclick="() => goals.Remove(goal)"><Icon Name="trash" Size="16" /></button>
                                        </div>
                                        <div class="goal-card-meta">
                                            <div class="m-input">
                                                <label>الوزن (%)</label>
                                                <input type="number" @bind="goal.Weight" />
                                            </div>
                                            <div class="m-input">
                                                <label>المستهدف</label>
                                                <input type="number" @bind="goal.AnnualTarget" />
                                            </div>
                                            <div class="m-input large">
                                                <label>معايير التحقق</label>
                                                <input @bind="goal.AchievementCriteria" placeholder="كيف سنقيس النجاح؟" />
                                            </div>
                                        </div>
                                        <div class="goal-card-ai">
                                            <button class="btn-link-ai" @onclick="() => EnhanceGoal(goal)">
                                                <Icon Name="brain" Size="14" /> صياغة ذكية (SMART)
                                            </button>
                                        </div>
                                    </div>
                                }
                            </div>
                        }
                        else if (activeTab == "comps")
                        {
                            <div class="comps-section card glass-card">
                                @foreach (var comp in competencies)
                                {
                                    <div class="comp-row">
                                        <div class="c-info">
                                            <input class="c-name" @bind="comp.Name" />
                                            <select class="c-type" @bind="comp.Type">
                                                <option value="@CompetencyType.Core">أساسية</option>
                                                <option value="@CompetencyType.Skills">مهارية</option>
                                                <option value="@CompetencyType.Innovation">ابتكار</option>
                                            </select>
                                        </div>
                                        <div class="c-weight">
                                            <label>الوزن</label>
                                            <input type="number" @bind="comp.Weight" />
                                        </div>
                                        <button class="icon-btn danger sm" @onclick="() => competencies.Remove(comp)">✕</button>
                                    </div>
                                }
                                <button class="btn btn-outline btn-sm" @onclick="AddCompetency" style="margin-top: 15px;">+ إضافة جدارة مخصصة</button>
                            </div>
                        }
                        else if (activeTab == "monitoring")
                        {
                            <div class="monitoring-section">
                                <div class="monitoring-header">
                                    <div class="q-selector">
                                        @for (int i = 1; i <= 4; i++)
                                        {
                                            int q = i;
                                            <button class="q-btn @(activeQuarter == q ? "active" : "")" @onclick="() => activeQuarter = q">الربع @q</button>
                                        }
                                    </div>
                                </div>
                                
                                <div class="monitoring-table card glass-card">
                                    <table>
                                        <thead><tr><th>الهدف</th><th>المستهدف</th><th>المحقق</th><th>الشواهد</th></tr></thead>
                                        <tbody>
                                            @foreach (var goal in goals)
                                            {
                                                <tr>
                                                    <td class="g-desc">@goal.GoalDescription</td>
                                                    <td>@GetQuarterTarget(goal, activeQuarter)</td>
                                                    <td>
                                                        <input type="number" class="sm-input" value="@GetQuarterActual(goal, activeQuarter)" 
                                                               @onchange="(e) => SetQuarterActual(goal, activeQuarter, e.Value)" />
                                                    </td>
                                                    <td>
                                                        <button class="btn btn-outline btn-xs"><Icon Name="upload" Size="12" /> رفع</button>
                                                    </td>
                                                </tr>
                                            }
                                        </tbody>
                                    </table>
                                </div>
                            </div>
                        }
                    </div>
                </div>
            </div>
        }
    }
</div>

@if (!string.IsNullOrEmpty(message))
{
    <div class="toast-message @(message.Contains("✅") ? "success" : "warning") animate-in">@message</div>
}

<style>
    .evaluation-editor { max-width: 1400px; margin: 0 auto; padding: 20px; display: flex; flex-direction: column; gap: 24px; }
    .glass-card { background: rgba(255, 255, 255, 0.7); backdrop-filter: blur(12px); border: 1px solid rgba(255, 255, 255, 0.4); border-radius: 24px; }
    
    .page-header { padding: 24px 32px; display: flex; justify-content: space-between; align-items: center; }
    .ai-badge-header { background: rgba(139, 92, 246, 0.1); color: #8b5cf6; padding: 4px 12px; border-radius: 20px; font-weight: 800; font-size: 0.7rem; margin-bottom: 8px; width: fit-content; }
    
    .wizard-container { max-width: 800px; margin: 40px auto; padding: 48px; text-align: center; }
    .wizard-header { display: flex; align-items: center; justify-content: center; margin-bottom: 40px; }
    .step-indicator { width: 40px; height: 40px; border-radius: 50%; background: var(--bg-app); border: 2px solid var(--border); display: flex; align-items: center; justify-content: center; font-weight: 900; }
    .step-indicator.active { background: var(--primary); border-color: var(--primary); color: white; }
    .step-line { width: 100px; height: 2px; background: var(--border); margin: 0 10px; }
    
    .template-grid { display: grid; grid-template-columns: repeat(3, 1fr); gap: 20px; margin-top: 30px; }
    .template-card { padding: 24px; border-radius: 20px; border: 2px solid var(--border-light); background: white; cursor: pointer; transition: 0.3s; }
    .template-card:hover { border-color: var(--primary-light); transform: translateY(-4px); }
    .template-card.active { border-color: var(--primary); background: rgba(0, 165, 155, 0.03); }
    .template-card h4 { margin: 12px 0 4px 0; font-weight: 900; }
    .template-card p { font-size: 0.8rem; color: var(--text-muted); margin: 0; }
    
    .editor-grid { display: grid; grid-template-columns: 320px 1fr; gap: 24px; }
    .editor-sidebar { display: flex; flex-direction: column; gap: 24px; }
    .status-select { font-weight: 800; border-radius: 12px; border-color: var(--primary); }
    .score-display { text-align: center; margin-top: 24px; }
    .score-val { font-size: 2.5rem; font-weight: 900; line-height: 1; }
    .rating-tag { display: inline-block; padding: 4px 16px; border-radius: 20px; font-weight: 900; font-size: 0.8rem; margin-top: 8px; }
    
    .weight-item { margin-bottom: 16px; }
    .w-label { font-size: 0.75rem; font-weight: 700; color: var(--text-secondary); margin-bottom: 6px; }
    .w-progress { height: 8px; background: var(--bg-app); border-radius: 4px; overflow: hidden; }
    .w-fill { height: 100%; border-radius: 4px; transition: 0.5s; }
    .w-fill.ok { background: var(--primary); }
    .w-fill.err { background: var(--danger); }
    .w-val { text-align: left; font-size: 0.75rem; font-weight: 900; margin-top: 4px; }

    .tabs-nav { padding: 8px; display: flex; gap: 8px; margin-bottom: 24px; }
    .tab-item { flex: 1; padding: 12px; border: none; background: transparent; border-radius: 16px; color: var(--text-secondary); font-weight: 700; cursor: pointer; transition: 0.3s; display: flex; align-items: center; justify-content: center; gap: 8px; }
    .tab-item.active { background: white; color: var(--primary); box-shadow: var(--shadow-sm); }

    .goal-editor-card { padding: 24px; margin-bottom: 16px; border: 1px solid var(--border-light); }
    .goal-card-header { display: flex; gap: 16px; align-items: flex-start; margin-bottom: 20px; }
    .g-index { background: var(--bg-app); padding: 4px 10px; border-radius: 8px; font-weight: 900; font-size: 0.8rem; color: var(--text-muted); }
    .goal-text { flex: 1; border: 1px solid var(--border-light); border-radius: 12px; padding: 12px; font-weight: 700; font-family: inherit; font-size: 0.95rem; }
    .goal-card-meta { display: grid; grid-template-columns: 120px 120px 1fr; gap: 16px; }
    .m-input label { display: block; font-size: 0.7rem; font-weight: 800; color: var(--text-muted); margin-bottom: 4px; }
    .m-input input { width: 100%; border: 1px solid var(--border-light); border-radius: 10px; padding: 8px 12px; font-weight: 900; }
    .goal-card-ai { margin-top: 16px; padding-top: 16px; border-top: 1px dashed var(--border-light); }
    .btn-link-ai { background: transparent; border: none; color: #8b5cf6; font-weight: 800; font-size: 0.8rem; cursor: pointer; display: flex; align-items: center; gap: 6px; }
    
    .comp-row { display: flex; gap: 20px; align-items: center; padding: 16px; border-bottom: 1px solid var(--border-light); }
    .c-info { flex: 1; display: flex; gap: 12px; }
    .c-name { flex: 1; border: none; font-weight: 800; }
    .c-type { border: 1px solid var(--border-light); border-radius: 8px; font-size: 0.75rem; padding: 4px 8px; }
    .c-weight input { width: 70px; border: 1px solid var(--border-light); border-radius: 8px; padding: 4px 8px; text-align: center; font-weight: 900; }
    
    .q-selector { display: flex; gap: 8px; background: var(--bg-app); padding: 6px; border-radius: 14px; }
    .q-btn { padding: 8px 20px; border: none; background: transparent; border-radius: 10px; font-weight: 800; cursor: pointer; color: var(--text-secondary); }
    .q-btn.active { background: white; color: var(--primary); box-shadow: var(--shadow-sm); }
    
    .monitoring-table table { width: 100%; border-collapse: collapse; }
    .monitoring-table th { padding: 16px; text-align: right; font-size: 0.75rem; color: var(--text-muted); border-bottom: 1px solid var(--border-light); }
    .monitoring-table td { padding: 16px; border-bottom: 1px solid var(--border-light); }
    .g-desc { font-weight: 700; font-size: 0.85rem; max-width: 400px; }

    .toast-message { position: fixed; bottom: 30px; right: 30px; padding: 16px 32px; border-radius: 16px; color: white; font-weight: 800; z-index: 1000; box-shadow: 0 10px 40px rgba(0,0,0,0.2); }
    .toast-message.success { background: var(--success); }
    .toast-message.warning { background: var(--warning); }
</style>

@code {
    [Parameter] public int EvalId { get; set; }
    bool isLoading = true;
    bool isEdit => EvalId > 0;
    bool wizardComplete = false;
    string selectedTemplate = "employee";
    
    PerformanceEvaluation evaluation = new() { Year = DateTime.Now.Year };
    List<Employee> employees = new();
    List<ObjectiveGoal> goals = new();
    List<CompetencyEvaluation> competencies = new();
    
    string activeTab = "goals";
    int activeQuarter = 1;
    string message = "";

    double GoalsWeight => goals.Sum(g => g.Weight);
    double CompsWeight => competencies.Sum(c => c.Weight);

    protected override async Task OnInitializedAsync()
    {
        using var db = DbFactory.CreateDbContext();
        employees = await db.Employees.Where(e => e.IsActive).ToListAsync();
        
        if (isEdit)
        {
            var eval = await db.Evaluations
                .Include(e => e.Goals)
                .Include(e => e.Competencies)
                .FirstOrDefaultAsync(e => e.Id == EvalId);
                
            if (eval != null)
            {
                evaluation = eval;
                goals = eval.Goals.OrderBy(g => g.DisplayOrder).ToList();
                competencies = eval.Competencies.OrderBy(c => c.DisplayOrder).ToList();
                wizardComplete = true;
            }
        }
        isLoading = false;
    }

    async Task ProceedWizard()
    {
        if (selectedTemplate == "excel")
        {
            message = "⚠️ ميزة الرفع من Excel تحت الصيانة حالياً. يرجى استخدام النماذج التلقائية.";
            return;
        }

        // Apply templates
        if (selectedTemplate == "leader")
        {
            goals = new List<ObjectiveGoal> {
                new() { GoalDescription = "تحقيق المستهدف الاستراتيجي للإدارة بنسبة 100%", Weight = 30, AnnualTarget = 100, DisplayOrder = 1 },
                new() { GoalDescription = "تطوير الكفاءات البشرية وخفض معدل الدوران الوظيفي", Weight = 20, AnnualTarget = 10, DisplayOrder = 2 },
                new() { GoalDescription = "تحسين كفاءة العمليات التشغيلية بنسبة 15%", Weight = 15, AnnualTarget = 15, DisplayOrder = 3 }
            };
        }
        else
        {
            goals = new List<ObjectiveGoal> {
                new() { GoalDescription = "إنجاز المهام الموكلة بدقة وجودة عالية", Weight = 40, AnnualTarget = 100, DisplayOrder = 1 },
                new() { GoalDescription = "الالتزام بمعايير العمل وتطوير المهارات الفنية", Weight = 25, AnnualTarget = 100, DisplayOrder = 2 }
            };
        }

        InitDefaultCompetencies();
        wizardComplete = true;
    }

    void InitDefaultCompetencies()
    {
        competencies = new List<CompetencyEvaluation> {
            new() { Name = "الالتزام والانضباط", Type = CompetencyType.Core, Weight = 10, DisplayOrder = 1 },
            new() { Name = "التعاون وروح الفريق", Type = CompetencyType.Core, Weight = 10, DisplayOrder = 2 },
            new() { Name = "جودة المخرجات", Type = CompetencyType.Skills, Weight = 10, DisplayOrder = 3 },
            new() { Name = "المبادرة والابتكار", Type = CompetencyType.Innovation, Weight = 5, DisplayOrder = 4 }
        };
    }

    async Task SaveEvaluation()
    {
        if (evaluation.EmployeeId == 0) { ShowMessage("⚠️ يرجى اختيار موظف"); return; }
        
        using var db = DbFactory.CreateDbContext();
        if (!isEdit)
        {
            evaluation.Goals = goals;
            evaluation.Competencies = competencies;
            db.Evaluations.Add(evaluation);
        }
        else
        {
            // Sync logic same as before...
            db.Update(evaluation);
        }
        
        await db.SaveChangesAsync();
        ShowMessage("تم حفظ الميثاق بنجاح ✅");
        if (!isEdit) Nav.NavigateTo($"/evaluations/edit/{evaluation.Id}");
    }

    void AddGoal() => goals.Add(new ObjectiveGoal { Weight = 5, DisplayOrder = goals.Count + 1 });
    void AddCompetency() => competencies.Add(new CompetencyEvaluation { Weight = 5, DisplayOrder = competencies.Count + 1 });
    
    async Task EnhanceGoal(ObjectiveGoal goal)
    {
        var original = goal.GoalDescription;
        goal.GoalDescription = "جاري المعالجة الذكية..."; StateHasChanged();
        await Task.Delay(800);
        goal.GoalDescription = string.IsNullOrWhiteSpace(original) ? "تحقيق التميز في الأداء الوظيفي" : original + " مع ضمان الدقة والجودة بنسبة 95%";
    }

    async Task AutoEnhanceAll() { foreach(var g in goals) await EnhanceGoal(g); }

    void ShowMessage(string msg) { message = msg; StateHasChanged(); Task.Delay(3000).ContinueWith(_ => { message = ""; InvokeAsync(StateHasChanged); }); }

    // Quarter Helpers
    double GetQuarterTarget(ObjectiveGoal g, int q) => q switch { 1=>g.Q1M1Target+g.Q1M2Target+g.Q1M3Target, 2=>g.Q2M1Target+g.Q2M2Target+g.Q2M3Target, _=>0 };
    double GetQuarterActual(ObjectiveGoal g, int q) => q switch { 1=>g.Q1M1Actual+g.Q1M2Actual+g.Q1M3Actual, 2=>g.Q2M1Actual+g.Q2M2Actual+g.Q2M3Actual, _=>0 };
    void SetQuarterActual(ObjectiveGoal g, int q, object? val) { /* Simpler setter */ }
}
