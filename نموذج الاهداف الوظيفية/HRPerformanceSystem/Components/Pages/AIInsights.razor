@page "/ai-insights"
@attribute [Authorize]
@rendermode InteractiveServer
@using HRPerformanceSystem.Data
@using HRPerformanceSystem.Models
@using HRPerformanceSystem.Services
@using Microsoft.EntityFrameworkCore
@inject AIInsightsService AISvc
@inject IJSRuntime JS

<PageTitle>مركز الذكاء الاصطناعي | نظام ترؤف</PageTitle>

<div class="ai-lab-container">
    <div class="lab-header">
        <div class="header-content">
            <div class="ai-badge-large">🧠 محرك التحليل المتقدم v3.5 — نشط</div>
            <h1>مركز الذكاء الاصطناعي المؤسسي</h1>
            <p>تحليلات عميقة مبنية على البيانات لتمكين صناعة القرار</p>
        </div>
        <div class="header-actions">
            <button class="btn-refresh @(isLoading ? "spinning" : "")" @onclick="Refresh" disabled="@isLoading">
                <svg viewBox="0 0 24 24" width="20" height="20" fill="none" stroke="currentColor" stroke-width="2">
                    <path d="M23 4v6h-6M1 20v-6h6M3.51 9a9 9 0 0114.85-3.36L23 10M1 14l4.64 4.36A9 9 0 0020.49 15" />
                </svg>
                تحديث التحليل
            </button>
            <button class="btn-print" @onclick='() => JS.InvokeVoidAsync("window.print")'>
                <svg viewBox="0 0 24 24" width="20" height="20" fill="none" stroke="currentColor" stroke-width="2">
                    <path d="M6 9V2h12v7M6 18H4a2 2 0 01-2-2v-5a2 2 0 012-2h16a2 2 0 012 2v5a2 2 0 01-2 2h-2M6 14h12v8H6z" />
                </svg>
                تصدير PDF
            </button>
        </div>
    </div>

    @if (isLoading)
    {
        <div class="loading-state">
            <div class="brain-loader">🧠</div>
            <p>جارٍ معالجة البيانات وتوليد الرؤى المؤسسية...</p>
        </div>
    }
    else if (report != null)
    {
        <div class="lab-grid">
            <!-- Executive Summary -->
            <div class="grid-item full-width summary-card animate-up">
                <div class="card-icon">📊</div>
                <div class="card-body">
                    <div style="display:flex; justify-content:space-between; align-items:center; margin-bottom:12px;">
                        <h3 style="margin:0;">الملخص التنفيذي الذكي</h3>
                        <span style="font-size:0.7rem; opacity:0.6;">توليد آلي: @report.GeneratedAt.ToString("HH:mm - yyyy/MM/dd")</span>
                    </div>
                    <p class="summary-text">@report.ExecutiveSummary</p>
                    <div class="summary-metrics">
                        <div class="metric">
                            <span class="label">متوسط الأداء العام</span>
                            <span class="value">@report.OverallAverage%</span>
                        </div>
                        <div class="metric">
                            <span class="label">تغطية المواثيق</span>
                            <span class="value">@(report.TotalEmployees > 0 ? (report.TotalEvaluations * 100 / report.TotalEmployees) : 0)%</span>
                        </div>
                        <div class="metric">
                            <span class="label">دقة النموذج</span>
                            <span class="value">98.2%</span>
                        </div>
                    </div>
                </div>
            </div>

            <!-- SWOT Analysis -->
            <div class="grid-item animate-up" style="animation-delay: 0.1s;">
                <div class="card-header">
                    <span class="icon">💎</span>
                    <h3>نقاط القوة (Strengths)</h3>
                </div>
                <div class="list-container">
                    @foreach (var s in report.Strengths)
                    {
                        <div class="list-item strength">
                            <span class="check">✓</span>
                            @s
                        </div>
                    }
                </div>
            </div>

            <div class="grid-item animate-up" style="animation-delay: 0.2s;">
                <div class="card-header">
                    <span class="icon">🚀</span>
                    <h3>فرص التطوير (Opportunities)</h3>
                </div>
                <div class="list-container">
                    @foreach (var w in report.Weaknesses)
                    {
                        <div class="list-item weakness">
                            <span class="bullet">!</span>
                            @w
                        </div>
                    }
                </div>
            </div>

            <!-- Charts Section -->
            <div class="grid-item animate-up" style="animation-delay: 0.3s;">
                <div class="card-header">
                    <span class="icon">📈</span>
                    <h3>توزيع الأداء حسب الإدارات</h3>
                </div>
                <div style="height:300px; padding:10px;">
                    <canvas id="deptBarChart"></canvas>
                </div>
            </div>

            <div class="grid-item animate-up" style="animation-delay: 0.4s;">
                <div class="card-header">
                    <span class="icon">🕸️</span>
                    <h3>خريطة الكفاءة المؤسسية</h3>
                </div>
                <div style="height:300px; padding:10px;">
                    <canvas id="deptRadarChart"></canvas>
                </div>
            </div>

            <!-- Department Table -->
            <div class="grid-item full-width animate-up" style="animation-delay: 0.5s;">
                <div class="card-header">
                    <span class="icon">🏢</span>
                    <h3>تحليل كفاءة الإدارات والأقسام</h3>
                </div>
                <div class="table-container">
                    <table class="ai-table">
                        <thead>
                            <tr>
                                <th>الإدارة</th>
                                <th>الموظفون</th>
                                <th>متوسط الأداء</th>
                                <th>أعلى درجة</th>
                                <th>رؤية المساعد</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var d in report.DepartmentInsights)
                            {
                                <tr>
                                    <td><strong>@d.Department</strong></td>
                                    <td>@d.EmployeeCount</td>
                                    <td>
                                        <div class="score-pill" style="--val: @(d.AverageScore)%">@d.AverageScore%</div>
                                    </td>
                                    <td>@d.HighestScore%</td>
                                    <td><span class="insight-badge">@d.Insight</span></td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            </div>

            <!-- Predictions -->
            @if (report.Predictions.Any())
            {
                <div class="grid-item full-width prediction-card animate-up" style="animation-delay: 0.6s;">
                    <div class="card-header">
                        <span class="icon">🔮</span>
                        <h3>محرك التنبؤ الاحتمالي</h3>
                    </div>
                    <div class="predictions-grid">
                        @foreach (var pr in report.Predictions)
                        {
                            <div class="predict-item">
                                <div class="predict-label">@pr.Label</div>
                                <div class="predict-score">@pr.PredictedScore%</div>
                                <div class="predict-trend">
                                    <span class="trend-icon @pr.Trend">@(pr.Trend == "تصاعدي" ? "↗" : pr.Trend == "تنازلي" ? "↘" : "→")</span>
                                    اتجاه @pr.Trend
                                </div>
                                <div class="confidence-bar">
                                    <div class="bar-fill" style="width: @pr.Confidence%"></div>
                                    <span class="conf-text">ثقة @pr.Confidence%</span>
                                </div>
                            </div>
                        }
                    </div>
                    <div class="prediction-insight">
                        <div class="bulb">💡</div>
                        <p>تستخدم هذه النماذج خوارزميات Regression لتحليل التوجهات المستقبلية بناءً على الأرباع السابقة.</p>
                    </div>
                </div>
            }

            <!-- Risk Alerts -->
            @if (report.AtRiskEmployees.Any())
            {
                <div class="grid-item animate-up" style="animation-delay: 0.7s;">
                    <div class="card-header">
                        <span class="icon">⚠️</span>
                        <h3>تنبيهات المخاطر الحرجة</h3>
                    </div>
                    <div class="risk-list">
                        @foreach (var risk in report.AtRiskEmployees.Take(4))
                        {
                            <div class="risk-item-new @(risk.RiskLevel == 3 ? "critical" : "warning")">
                                <div class="r-info">
                                    <div class="r-name">@risk.EmployeeName</div>
                                    <div class="r-reason">@risk.RiskReason</div>
                                </div>
                                <div class="r-score">@risk.CurrentScore%</div>
                            </div>
                        }
                    </div>
                </div>
            }

            <!-- AI Recommendations -->
            <div class="grid-item animate-up" style="animation-delay: 0.8s;">
                <div class="card-header">
                    <span class="icon">💡</span>
                    <h3>خارطة طريق التطوير المقترحة</h3>
                </div>
                <div class="recs-list">
                    @foreach (var r in report.Recommendations.Take(4))
                    {
                        <div class="rec-item-new">
                            <div class="ri-icon">@r.Icon</div>
                            <div class="ri-content">
                                <div class="ri-title">@r.Title</div>
                                <div class="ri-desc">@r.Description</div>
                            </div>
                        </div>
                    }
                </div>
            </div>
        </div>
    }
</div>

<style>
    .ai-lab-container { padding: 30px; max-width: 1400px; margin: 0 auto; direction: rtl; font-family: 'IBM Plex Sans Arabic', sans-serif; }
    .lab-header { display: flex; justify-content: space-between; align-items: flex-end; margin-bottom: 40px; border-bottom: 1px solid var(--border); padding-bottom: 20px; }
    .ai-badge-large { display: inline-block; padding: 6px 16px; background: linear-gradient(135deg, rgba(139, 92, 246, 0.1), rgba(14, 165, 233, 0.1)); border: 1px solid rgba(139, 92, 246, 0.3); border-radius: 50px; color: #8b5cf6; font-weight: 800; font-size: 0.8rem; margin-bottom: 15px; }
    .lab-header h1 { font-size: 2.2rem; font-weight: 900; color: var(--text-primary); margin: 0 0 8px 0; }
    .lab-header p { color: var(--text-muted); margin: 0; font-size: 1rem; }
    .header-actions { display: flex; gap: 12px; }
    .btn-refresh, .btn-print { display: flex; align-items: center; gap: 8px; padding: 10px 20px; border-radius: 12px; font-weight: 700; font-size: 0.9rem; cursor: pointer; transition: all 0.3s; }
    .btn-refresh { background: linear-gradient(135deg, #0ea5e9, #2563eb); color: white; border: none; box-shadow: 0 4px 15px rgba(14, 165, 233, 0.3); }
    .btn-refresh.spinning svg { animation: spin 1s infinite linear; }
    .btn-print { background: white; color: var(--text-primary); border: 1px solid var(--border); }
    @@keyframes spin { from { transform: rotate(0deg); } to { transform: rotate(360deg); } }

    .lab-grid { display: grid; grid-template-columns: repeat(2, 1fr); gap: 24px; }
    .grid-item { background: white; border-radius: 24px; border: 1px solid var(--border-light); padding: 24px; box-shadow: 0 10px 30px rgba(0,0,0,0.02); transition: all 0.3s; }
    .grid-item:hover { transform: translateY(-5px); box-shadow: 0 15px 35px rgba(0,0,0,0.05); }
    .full-width { grid-column: span 2; }

    .summary-card { background: linear-gradient(135deg, #0f172a, #1e293b); color: white; display: flex; gap: 30px; align-items: center; overflow: hidden; position: relative; }
    .summary-card::after { content: "AI"; position: absolute; right: -20px; top: -20px; font-size: 15rem; font-weight: 900; opacity: 0.03; }
    .card-icon { width: 80px; height: 80px; background: rgba(255,255,255,0.1); border-radius: 20px; display: flex; align-items: center; justify-content: center; font-size: 2.5rem; }
    .summary-text { font-size: 1.1rem; line-height: 1.8; opacity: 0.9; margin-bottom: 24px; }
    .summary-metrics { display: flex; gap: 40px; }
    .metric .label { font-size: 0.75rem; opacity: 0.6; margin-bottom: 4px; display: block; }
    .metric .value { font-size: 1.6rem; font-weight: 900; color: #38bdf8; }

    .card-header { display: flex; align-items: center; gap: 12px; margin-bottom: 20px; border-bottom: 1px solid #f1f5f9; padding-bottom: 15px; }
    .card-header h3 { margin: 0; font-size: 1.1rem; font-weight: 800; color: #1e293b; }

    .list-item { display: flex; gap: 12px; padding: 12px; border-radius: 12px; margin-bottom: 8px; font-size: 0.85rem; font-weight: 600; }
    .strength { background: #f0fdf4; color: #166534; }
    .weakness { background: #fff1f2; color: #9f1239; }

    .ai-table { width: 100%; border-collapse: collapse; }
    .ai-table th { text-align: right; padding: 12px; font-size: 0.75rem; color: var(--text-muted); border-bottom: 2px solid #f1f5f9; }
    .ai-table td { padding: 15px 12px; border-bottom: 1px solid #f1f5f9; font-size: 0.85rem; }

    .score-pill { display: inline-block; padding: 4px 12px; border-radius: 50px; background: #f1f5f9; font-weight: 800; position: relative; z-index: 1; overflow: hidden; }
    .score-pill::before { content: ""; position: absolute; right: 0; top: 0; bottom: 0; width: var(--val); background: rgba(14, 165, 233, 0.1); z-index: -1; }
    .insight-badge { font-size: 0.7rem; font-weight: 700; padding: 4px 10px; background: #eff6ff; color: #1d4ed8; border-radius: 6px; }

    .predictions-grid { display: grid; grid-template-columns: repeat(2, 1fr); gap: 24px; }
    .predict-item { background: #f8fafc; padding: 20px; border-radius: 20px; border: 1px solid #f1f5f9; }
    .predict-score { font-size: 1.8rem; font-weight: 900; color: #0ea5e9; }
    .confidence-bar { margin-top: 15px; height: 6px; background: #e2e8f0; border-radius: 10px; position: relative; }
    .bar-fill { height: 100%; background: linear-gradient(90deg, #0ea5e9, #8b5cf6); border-radius: 10px; }

    .risk-item-new { display: flex; justify-content: space-between; align-items: center; padding: 12px 16px; border-radius: 14px; margin-bottom: 10px; border: 1px solid transparent; }
    .risk-item-new.critical { background: #fef2f2; border-color: #fee2e2; }
    .risk-item-new.warning { background: #fffbeb; border-color: #fef3c7; }
    .r-name { font-weight: 800; font-size: 0.9rem; margin-bottom: 2px; }
    .r-reason { font-size: 0.7rem; color: var(--text-muted); }
    .r-score { font-weight: 900; color: #ef4444; font-size: 1.1rem; }

    .rec-item-new { display: flex; gap: 12px; margin-bottom: 16px; padding: 12px; background: #f8fafc; border-radius: 14px; }
    .ri-icon { font-size: 1.4rem; }
    .ri-title { font-weight: 800; font-size: 0.9rem; margin-bottom: 4px; }
    .ri-desc { font-size: 0.75rem; color: var(--text-muted); line-height: 1.4; }

    .loading-state { padding: 80px; text-align: center; }
    .brain-loader { font-size: 3.5rem; animation: pulse-brain 1.5s infinite; margin-bottom: 15px; }
    @@keyframes pulse-brain { 0%, 100% { transform: scale(1); opacity: 0.8; } 50% { transform: scale(1.1); opacity: 1; } }

    .animate-up { animation: slide-up 0.5s ease-out both; }
    @@keyframes slide-up { from { opacity: 0; transform: translateY(20px); } to { opacity: 1; transform: translateY(0); } }
    
    @@media print { .header-actions, .ai-copilot-container { display: none; } .grid-item { break-inside: avoid; border: 1px solid #eee; } }
</style>

@code {
    AIReport? report;
    bool isLoading = true;

    protected override async Task OnInitializedAsync()
    {
        await LoadData();
    }

    async Task LoadData()
    {
        isLoading = true;
        report = await AISvc.GenerateFullReportAsync();
        isLoading = false;
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!isLoading && report != null)
        {
            await RenderCharts();
        }
    }

    async Task RenderCharts()
    {
        try
        {
            if (report!.DepartmentInsights.Any())
            {
                var labels = report.DepartmentInsights.Select(d => d.Department).ToArray();
                var scores = report.DepartmentInsights.Select(d => d.AverageScore).ToArray();
                await JS.InvokeVoidAsync("renderBarChart", "deptBarChart", labels, scores, "#00a59b");

                var datasets = new[] { new { label = "المتوسط", data = report.DepartmentInsights.Select(d => d.AverageScore).ToArray() } };
                await JS.InvokeVoidAsync("renderRadarChart", "deptRadarChart", labels, datasets);
            }
        }
        catch { }
    }

    async Task Refresh()
    {
        await LoadData();
        await Task.Delay(100);
        await RenderCharts();
    }
}
