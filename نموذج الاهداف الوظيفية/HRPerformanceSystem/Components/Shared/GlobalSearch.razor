@using HRPerformanceSystem.Services
@inject SearchService SearchSvc
@inject NavigationManager Nav

<div class="search-wrapper">
    <div class="search-input-box">
        <Icon Name="search" Size="18" />
        <input type="text" placeholder="ابحث عن موظف، تقرير، أو صفحة..." @bind="query" @oninput="OnSearchInput" />
    </div>

    @if (results.Any())
    {
        <div class="search-results-dropdown animate-in">
            @foreach (var res in results)
            {
                <div class="search-result-item" @onclick="() => NavigateTo(res.Link)">
                    <div class="res-icon"><Icon Name="@res.Icon" Size="18" /></div>
                    <div class="res-info">
                        <div class="res-title">@res.Title</div>
                        <div class="res-subtitle">@res.Subtitle</div>
                    </div>
                </div>
            }
        </div>
    }
</div>

<style>
    .search-wrapper { position: relative; width: 350px; }
    .search-input-box {
        display: flex;
        align-items: center;
        background: rgba(255, 255, 255, 0.05);
        border: 1.5px solid rgba(0, 165, 155, 0.1);
        border-radius: 12px;
        padding: 8px 15px;
        gap: 10px;
        transition: all 0.3s;
    }
    .search-input-box:focus-within {
        background: white;
        border-color: var(--primary);
        box-shadow: 0 4px 12px rgba(0, 165, 155, 0.1);
    }
    .search-input-box input {
        border: none;
        background: none;
        width: 100%;
        outline: none;
        font-size: 0.85rem;
        font-weight: 600;
        color: var(--text-primary);
    }
    .search-input-box input::placeholder { color: var(--text-muted); font-weight: 500; }
    
    .search-results-dropdown {
        position: absolute;
        top: 100%;
        left: 0;
        right: 0;
        background: white;
        margin-top: 10px;
        border-radius: 16px;
        box-shadow: 0 20px 40px rgba(0,0,0,0.1);
        border: 1px solid var(--border-light);
        overflow: hidden;
        z-index: 1000;
        backdrop-filter: blur(20px);
    }
    .search-result-item {
        display: flex;
        align-items: center;
        gap: 12px;
        padding: 12px 16px;
        cursor: pointer;
        transition: all 0.2s;
    }
    .search-result-item:hover { background: rgba(0, 165, 155, 0.05); }
    .res-icon { color: var(--primary); opacity: 0.7; }
    .res-title { font-weight: 800; font-size: 0.85rem; color: var(--text-primary); }
    .res-subtitle { font-size: 0.7rem; color: var(--text-muted); }

    [data-theme='dark'] .search-results-dropdown {
        background: rgba(30, 41, 59, 0.95);
        border-color: rgba(255,255,255,0.05);
    }
    [data-theme='dark'] .search-input-box:focus-within {
        background: rgba(15, 23, 42, 0.8);
    }
</style>

@code {
    private string query = "";
    private List<SearchResult> results = new();

    private async Task OnSearchInput(ChangeEventArgs e)
    {
        query = e.Value?.ToString() ?? "";
        if (query.Length >= 2)
        {
            results = await SearchSvc.SearchAsync(query);
        }
        else
        {
            results.Clear();
        }
    }

    private void NavigateTo(string link)
    {
        results.Clear();
        query = "";
        Nav.NavigateTo(link);
    }
}
