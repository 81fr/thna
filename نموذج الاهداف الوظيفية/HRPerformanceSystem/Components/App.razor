<!DOCTYPE html>
<html lang="ar" dir="rtl">

<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="description" content="نظام إدارة الأداء الوظيفي - جمعية ترؤف لرعاية الأيتام" />
    <meta name="theme-color" content="#00a59b" />
    <title>نظام إدارة الأداء | ترؤف</title>
    <base href="/" />
    <ResourcePreloader />
    <link rel="stylesheet" href="lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.1/font/bootstrap-icons.css">
    <link rel="stylesheet" href="css/app.css" />
    <link rel="stylesheet" href="HRPerformanceSystem.styles.css" />
    <ImportMap />
    <link rel="icon" type="image/png" href="favicon.png" />
    <HeadOutlet @rendermode="PageRenderMode" />
</head>

<body>
    <Routes @rendermode="PageRenderMode" />
    <ReconnectModal />
    <script src="@Assets["_framework/blazor.web.js"]"></script>
    <script src="@Assets["Components/Account/Shared/PasskeySubmit.razor.js"]" type="module"></script>
    <script src="https://cdn.jsdelivr.net/npm/chart.js"></script>
    <script>
        window.themeManager = {
            toggleTheme: function () {
                const isDark = document.documentElement.getAttribute('data-theme') === 'dark';
                const newTheme = isDark ? 'light' : 'dark';
                document.documentElement.setAttribute('data-theme', newTheme);
                localStorage.setItem('theme', newTheme);
                return newTheme;
            },
            getTheme: function () {
                const saved = localStorage.getItem('theme') || 'light';
                document.documentElement.setAttribute('data-theme', saved);
                return saved;
            }
        };
        // Apply immediately
        document.documentElement.setAttribute('data-theme', localStorage.getItem('theme') || 'light');

        window.renderLineChart = function(id, labels, data, labelTitle) {
            const ctx = document.getElementById(id);
            if (!ctx) return;
            let existingChart = Chart.getChart(ctx);
            if (existingChart) existingChart.destroy();
            
            const isDark = document.documentElement.getAttribute('data-theme') === 'dark';
            const textColor = isDark ? '#f8fafc' : '#475569';
            const gridColor = isDark ? '#334155' : '#e2e8f0';

            new Chart(ctx, {
                type: 'line',
                data: {
                    labels: labels,
                    datasets: [{
                        label: labelTitle,
                        data: data,
                        borderColor: '#00a59b',
                        backgroundColor: 'rgba(0, 165, 155, 0.1)',
                        borderWidth: 3,
                        tension: 0.4,
                        fill: true,
                        pointBackgroundColor: '#ffffff',
                        pointBorderColor: '#00a59b',
                        pointRadius: 4,
                        pointHoverRadius: 6
                    }]
                },
                options: {
                    responsive: true,
                    maintainAspectRatio: false,
                    plugins: {
                        legend: { display: false },
                        tooltip: { backgroundColor: '#1e293b', titleFont: { family: 'Tajawal' }, bodyFont: { family: 'Tajawal' } }
                    },
                    scales: {
                        y: { beginAtZero: true, max: 100, ticks: { color: textColor, font: { family: 'Tajawal' } }, grid: { color: gridColor } },
                        x: { ticks: { color: textColor, font: { family: 'Tajawal' } }, grid: { display: false } }
                    }
                }
            });
        };

        window.renderDoughnutChart = function(id, labels, data, colors) {
            const ctx = document.getElementById(id);
            if (!ctx) return;
            let ex = Chart.getChart(ctx);
            if (ex) ex.destroy();
            new Chart(ctx, {
                type: 'doughnut',
                data: { labels: labels, datasets: [{ data: data, backgroundColor: colors, borderWidth: 2, borderColor: 'white', hoverOffset: 8 }] },
                options: { responsive: true, maintainAspectRatio: false, cutout: '65%', plugins: { legend: { position: 'bottom', rtl: true, labels: { font: { family: 'Tajawal', weight: '700', size: 11 }, padding: 16, usePointStyle: true } } } }
            });
        };

        window.renderRadarChart = function(id, labels, datasets) {
            const ctx = document.getElementById(id);
            if (!ctx) return;
            let ex = Chart.getChart(ctx);
            if (ex) ex.destroy();
            const isDark = document.documentElement.getAttribute('data-theme') === 'dark';
            const gridColor = isDark ? '#334155' : '#e2e8f0';
            new Chart(ctx, {
                type: 'radar',
                data: { labels: labels, datasets: datasets.map((ds, i) => ({ label: ds.label, data: ds.data, borderColor: ['#00a59b','#8b5cf6','#f59e0b','#ef4444'][i%4], backgroundColor: ['rgba(0,165,155,0.15)','rgba(139,92,246,0.15)','rgba(245,158,11,0.15)','rgba(239,68,68,0.15)'][i%4], borderWidth: 2, pointRadius: 3 })) },
                options: { responsive: true, maintainAspectRatio: false, scales: { r: { beginAtZero: true, max: 100, grid: { color: gridColor }, pointLabels: { font: { family: 'Tajawal', size: 11, weight: '700' } }, ticks: { display: false } } }, plugins: { legend: { position: 'bottom', rtl: true, labels: { font: { family: 'Tajawal', weight: '700' }, usePointStyle: true } } } }
            });
        };

        window.renderBarChart = function(id, labels, data, color) {
            const ctx = document.getElementById(id);
            if (!ctx) return;
            let ex = Chart.getChart(ctx);
            if (ex) ex.destroy();
            const isDark = document.documentElement.getAttribute('data-theme') === 'dark';
            new Chart(ctx, {
                type: 'bar',
                data: { labels: labels, datasets: [{ data: data, backgroundColor: color || '#00a59b', borderRadius: 8, barPercentage: 0.6 }] },
                options: { responsive: true, maintainAspectRatio: false, indexAxis: 'y', plugins: { legend: { display: false } }, scales: { x: { beginAtZero: true, max: 100, grid: { display: false }, ticks: { font: { family: 'Tajawal' } } }, y: { grid: { display: false }, ticks: { font: { family: 'Tajawal', weight: '700' } } } } }
            });
        };
    </script>
</body>

</html>

@code {
    [CascadingParameter]
    private HttpContext HttpContext { get; set; } = default!;

    private IComponentRenderMode? PageRenderMode =>
        HttpContext.AcceptsInteractiveRouting() ? InteractiveServer : null;
}
