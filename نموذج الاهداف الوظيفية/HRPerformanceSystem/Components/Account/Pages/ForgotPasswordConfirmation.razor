@page "/Account/ForgotPasswordConfirmation"

<PageTitle>تم إرسال رابط استعادة كلمة المرور | نظام إدارة الأداء</PageTitle>

<div class="auth-container">
    <div class="auth-card animate-in">
        <div class="auth-header">
            <div class="auth-logo">
                <img src="/images/logo.png" alt="ترؤف" style="max-height: 60px; filter: drop-shadow(0 4px 10px rgba(0,165,155,0.2));" />
            </div>
            <h1>تحقق من بريدك</h1>
            <p class="text-muted">تم إرسال تعليمات استعادة كلمة المرور إلى بريدك الإلكتروني.</p>
        </div>

        <div class="text-center mt-4">
            <div class="mb-4">
                <i class="bi bi-envelope-check text-primary" style="font-size: 4rem;"></i>
            </div>
            <p>إذا لم يصلك البريد في غضون دقائق، يرجى التحقق من مجلد البريد المهمل (Spam).</p>
            <a href="Account/Login" class="btn btn-primary btn-premium-auth w-100 mt-3">العودة لتسجيل الدخول</a>
        </div>
    </div>
</div>

<style>
    .auth-container {
        min-height: 80vh;
        display: flex;
        align-items: center;
        justify-content: center;
        padding: 20px;
    }
    .auth-card {
        background: rgba(255, 255, 255, 0.95);
        backdrop-filter: blur(10px);
        border: 1px solid rgba(0, 165, 155, 0.1);
        border-radius: 24px;
        box-shadow: 0 20px 40px rgba(0,0,0,0.05);
        width: 100%;
        max-width: 450px;
        padding: 40px;
    }
    .auth-header {
        text-align: center;
        margin-bottom: 30px;
    }
    .auth-header h1 {
        font-weight: 900;
        color: var(--text-primary);
        font-size: 1.75rem;
        margin-top: 15px;
        margin-bottom: 5px;
    }
    .btn-premium-auth {
        border-radius: 12px;
        padding: 14px;
        font-weight: 800;
        background: linear-gradient(135deg, var(--primary) 0%, #0d9488 100%);
        border: none;
        box-shadow: 0 10px 20px rgba(13, 148, 136, 0.2);
    }
    [data-theme='dark'] .auth-card {
        background: rgba(30, 41, 59, 0.95);
        border-color: rgba(255,255,255,0.1);
    }
</style>
